@page "/plataforma-servicios/nuevo"
@using System
@using System.Collections.Generic
@using System.Linq
@using BlazorApp.Models
@using BlazorApp.Models.PlataformaServicios
@using BlazorApp.Services
@using BlazorApp.Services.PlataformaServicios
@using BlazorApp.Shared
@using MudBlazor
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitleBar Title="Nuevo trámite"
              Subtitle="Wizard demo para registrar un trámite de ventanilla única municipal sin backend real ni tabs para creación.">
    <Actions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBackToIndexAsync">Volver a bandeja</MudButton>
    </Actions>
</PageTitleBar>

<MudStack Spacing="3">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Esta pantalla reutiliza el estándar wizard transversal y simula recepción, clasificación, control de calidad y derivación a módulos resolutores.
    </MudAlert>

    <WizardShell Title="Plataforma de Servicios"
                 Subtitle="Registro guiado de un trámite de ventanilla única."
                 ModuleName="Plataforma de Servicios"
                 ProcessCode="@draft.CaseNumber"
                 SummaryTitle="Resumen del trámite"
                 State="@wizardState"
                 ProcessSummaryItems="@BuildProcessSummaryItems()"
                 CurrentStepTitle="@GetCurrentStepTitle()"
                 CurrentStepSubtitle="@GetCurrentStepSubtitle()"
                 LastAuditEvent="@lastAuditEvent"
                 NextSuggestedStep="@GetNextSuggestedStep()"
                 DraftSavedBy="@draftState.SavedBy"
                 DraftMessage="@draftState.Message"
                 CanGoBack="@CanGoBack"
                 CanGoNext="@CanGoNext"
                 CanFinish="@CanFinish"
                 ShowValidationSummary="true"
                 OnBack="PreviousStepAsync"
                 OnNext="NextStepAsync"
                 OnSaveDraft="SaveDraftAsync"
                 OnCancel="CancelAsync"
                 OnFinish="FinishAsync">
        <ChildContent>
            @switch (wizardState.CurrentStepIndex)
            {
                case 0:
                    <MudStack Spacing="3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Value="@selectedTypeCode" ValueChanged="OnTypeChangedAsync" Label="Tipo de trámite" Variant="Variant.Outlined" Dense="true">
                                    <MudSelectItem Value="@string.Empty">Seleccione</MudSelectItem>
                                    @foreach (var type in procedureTypes)
                                    {
                                        <MudSelectItem Value="@type.Code">@type.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="draft.Channel" Label="Canal de ingreso" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var channel in channelOptions)
                                    {
                                        <MudSelectItem Value="@channel">@channel</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="draft.Priority" Label="Prioridad" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var priority in priorityOptions)
                                    {
                                        <MudSelectItem Value="@priority">@priority</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="draft.ResolverModule" Label="Módulo resolutor sugerido" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var module in moduleOptions)
                                    {
                                        <MudSelectItem Value="@module">@module</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="draft.Department" Label="Departamento sugerido" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var department in departmentOptions)
                                    {
                                        <MudSelectItem Value="@department">@department</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="draft.Status" Label="Estado inicial" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var status in initialStatuses)
                                    {
                                        <MudSelectItem Value="@status">@status</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.CaseNumber" Label="Expediente mock" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Summary" Label="Descripción breve" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.ReferenciaExterna" Label="Referencia externa" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        </MudGrid>

                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">Expediente @draft.CaseNumber</MudChip>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@draft.ResolverModule</MudChip>
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">@draft.Department</MudChip>
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@draft.Priority</MudChip>
                        </MudStack>
                    </MudStack>
                    break;
                case 1:
                    <MudStack Spacing="3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Applicant.Identification" Label="Identificación" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Applicant.Name" Label="Nombre o razón social" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="draft.Applicant.PersonType" Label="Tipo de persona" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var personType in personTypes)
                                    {
                                        <MudSelectItem Value="@personType">@personType</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Applicant.Phone" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Applicant.Email" Label="Correo" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" @bind-Value="draft.Applicant.PreferredNotification" Label="Medio de notificación" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var channel in notificationChannels)
                                    {
                                        <MudSelectItem Value="@channel">@channel</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="draft.Applicant.FiscalAddress" Label="Dirección fiscal" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="3"><MudSwitch @bind-Value="draft.Applicant.ExistsInRuc" Color="Color.Primary" Label="Existe en RUC" /></MudItem>
                            <MudItem xs="12" md="3"><MudTextField T="string" @bind-Value="draft.Applicant.RucStatus" Label="Estado RUC mock" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        </MudGrid>

                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            <MudChip T="string" Color="@(draft.Applicant.ExistsInRuc ? Color.Success : Color.Warning)" Variant="Variant.Outlined">@draft.Applicant.RucStatus</MudChip>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@draft.Applicant.RucQuality</MudChip>
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">@draft.Applicant.PreferredNotification</MudChip>
                        </MudStack>

                        <div class="d-flex flex-wrap gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchRucAsync">Buscar en RUC</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Badge" OnClick="ViewRucAsync">Ver RUC</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateApplicantAsync">Crear contribuyente</MudButton>
                        </div>
                    </MudStack>
                    break;
                case 2:
                    <MudStack Spacing="3">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">El objeto se adapta al tipo de trámite seleccionado.</MudAlert>
                        @if (RequiresFinca())
                        {
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.IdPredial" Label="ID Predial" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.NumeroFinca" Label="Número de finca" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.NumeroPlano" Label="Número de plano" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.Distrito" Label="Distrito" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="8"><MudTextField T="string" @bind-Value="draft.Object.Propietario" Label="Propietario" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                        }
                        @if (RequiresPatent())
                        {
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.NumeroLicencia" Label="Número de licencia" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.NombreComercial" Label="Nombre comercial" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.ActividadEconomica" Label="Actividad económica" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="8"><MudTextField T="string" @bind-Value="draft.Object.UsoSuelo" Label="Uso de suelo relacionado" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="ViewRelatedAsync">Ver patente</MudButton></MudItem>
                            </MudGrid>
                        }
                        @if (RequiresConstruction())
                        {
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.NumeroFinca" Label="Finca" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.ProfesionalResponsable" Label="Profesional responsable mock" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.TipoObra" Label="Tipo de obra" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.Area" Label="Área" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.MontoEstimado" Label="Monto estimado" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.HomeWork" OnClick="ViewRelatedAsync">Ver permiso</MudButton></MudItem>
                            </MudGrid>
                        }
                        @if (RequiresMarket())
                        {
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.NumeroLocal" Label="Número de local" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.Arrendatario" Label="Arrendatario" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.Contrato" Label="Contrato" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="8"><MudTextField T="string" @bind-Value="draft.Object.EstadoCuentaMock" Label="Estado de cuenta mock" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Store" OnClick="ViewRelatedAsync">Ver local</MudButton></MudItem>
                            </MudGrid>
                        }
                        @if (RequiresRuc())
                        {
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.TipoActualizacionRuc" Label="Tipo de actualización" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.DatosAModificar" Label="Datos a modificar" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Object.OrigenSolicitud" Label="Origen de solicitud" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                        }
                        @if (!RequiresFinca() && !RequiresPatent() && !RequiresConstruction() && !RequiresMarket() && !RequiresRuc())
                        {
                            <MudGrid Spacing="2">
                                <MudItem xs="12"><MudTextField T="string" @bind-Value="draft.Object.Descripcion" Label="Descripción" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12"><MudTextField T="string" @bind-Value="draft.Object.Observaciones" Label="Observaciones" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                        }
                    </MudStack>
                    break;
                case 3:
                    <MudStack Spacing="3">
                        <MudTable T="PsRequirementDto" Items="@draft.Requirements" Dense="true" Hover="true" Striped="true">
                            <HeaderContent>
                                <MudTh>Requisito</MudTh>
                                <MudTh>Estado</MudTh>
                                <MudTh>Documento</MudTh>
                                <MudTh>Observación</MudTh>
                                <MudTh>Acción</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Requisito">@context.Name</MudTd>
                                <MudTd DataLabel="Estado">
                                    <MudSelect T="string" Value="@context.Status" ValueChanged="@((value) => OnRequirementStatusChangedAsync(context, value))" Dense="true" Variant="Variant.Outlined">
                                        @foreach (var status in requirementStatuses)
                                        {
                                            <MudSelectItem Value="@status">@status</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd DataLabel="Documento"><MudTextField T="string" @bind-Value="context.DocumentPlaceholder" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                <MudTd DataLabel="Observación"><MudTextField T="string" @bind-Value="context.Observation" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                <MudTd DataLabel="Acción">
                                    <div class="d-flex flex-wrap gap-1">
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MarkRequirementPresentedAsync(context))">Marcar presentado</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MarkRequirementPendingAsync(context))">Marcar pendiente</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MarkRequirementObservedAsync(context))">Observar requisito</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ViewDocumentAsync(context))">Ver documento mock</MudButton>
                                    </div>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                    break;
                case 4:
                    <MudStack Spacing="3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Classification.ModuleName" Label="Módulo resolutor" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Classification.DepartmentName" Label="Departamento asignado" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Classification.Responsible" Label="Funcionario responsable" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Classification.Team" Label="Equipo responsable" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudSelect T="string" @bind-Value="draft.Classification.Status" Label="Estado de clasificación" Variant="Variant.Outlined" Dense="true">@foreach (var status in classificationStatuses){<MudSelectItem Value="@status">@status</MudSelectItem>}</MudSelect></MudItem>
                            <MudItem xs="12" md="4"><MudSelect T="string" @bind-Value="draft.Classification.TimeStatus" Label="Semáforo de plazo" Variant="Variant.Outlined" Dense="true">@foreach (var status in deadlineStatuses){<MudSelectItem Value="@status">@status</MudSelectItem>}</MudSelect></MudItem>
                            <MudItem xs="12" md="4"><MudSelect T="string" @bind-Value="draft.Classification.Priority" Label="Prioridad mock" Variant="Variant.Outlined" Dense="true">@foreach (var priority in priorityOptions){<MudSelectItem Value="@priority">@priority</MudSelectItem>}</MudSelect></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Classification.EstimatedDeadline" Label="Plazo estimado" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="draft.Classification.TransferMessage" Label="Mensaje de traslado mock" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        </MudGrid>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@draft.Classification.ModuleName</MudChip>
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">@draft.Classification.DepartmentName</MudChip>
                            <MudChip T="string" Color="@GetTimeColor(draft.Classification.TimeStatus)" Variant="Variant.Outlined">@draft.Classification.TimeStatus</MudChip>
                            <MudChip T="string" Color="@GetPriorityColor(draft.Classification.Priority)" Variant="Variant.Filled">@draft.Classification.Priority</MudChip>
                        </MudStack>
                        <div class="d-flex flex-wrap gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="TransferMockAsync">Trasladar a departamento mock</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.PersonSearch" OnClick="AssignResponsibleMockAsync">Asignar responsable mock</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.PriorityHigh" OnClick="ChangePriorityMockAsync">Cambiar prioridad mock</MudButton>
                        </div>
                    </MudStack>
                    break;
                case 5:
                    <MudStack Spacing="3">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Validaciones de recepción</MudText>
                                <MudStack Spacing="1" Class="mt-2">
                                    <MudChip T="string" Color="@GetValidationColor(IsApplicantReady())" Variant="Variant.Outlined">Solicitante identificado</MudChip>
                                    <MudChip T="string" Color="@GetValidationColor(IsRucReady())" Variant="Variant.Outlined">RUC validado o pendiente</MudChip>
                                    <MudChip T="string" Color="@GetValidationColor(IsObjectReady())" Variant="Variant.Outlined">Objeto completo</MudChip>
                                    <MudChip T="string" Color="@GetValidationColor(IsRequirementsReady())" Variant="Variant.Outlined">Requisitos completos</MudChip>
                                    <MudChip T="string" Color="@GetValidationColor(!string.IsNullOrWhiteSpace(draft.Classification.DepartmentName))" Variant="Variant.Outlined">Departamento asignado</MudChip>
                                    <MudChip T="string" Color="@GetValidationColor(!string.IsNullOrWhiteSpace(draft.Applicant.PreferredNotification))" Variant="Variant.Outlined">Medio de notificación definido</MudChip>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle1">Control de calidad</MudText>
                                        <MudSelect T="string" @bind-Value="qualityStatus" Label="Estado" Variant="Variant.Outlined" Dense="true">
                                            @foreach (var status in qualityStatuses)
                                            {
                                                <MudSelectItem Value="@status">@status</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudTextField T="string" @bind-Value="qualityObservation" Label="Observaciones" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudTextField T="string" @bind-Value="qualityReturnReason" Label="Motivo de devolución" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudTextField T="string" @bind-Value="qualityResponsible" Label="Responsable de revisión" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle1">Resumen operativo</MudText>
                                        <MudText Typo="Typo.body2">@GetCurrentStepTitle()</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@wizardState.CurrentStepId</MudText>
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">La integración resolutora se simula solo a nivel visual.</MudAlert>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                        <div class="d-flex flex-wrap gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveReceptionAsync">Aprobar recepción</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Reply" OnClick="ReturnProcedureAsync">Devolver trámite</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.SyncAlt" OnClick="ReassignAsync">Reasignar</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowForward" OnClick="ContinueAsync">Continuar</MudButton>
                        </div>
                    </MudStack>
                    break;
                case 6:
                    <MudStack Spacing="3">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Resumen final del expediente</MudText>
                                <MudGrid Spacing="2" Class="mt-2">
                                    <MudItem xs="12" md="6"><MudTextField T="string" Value="@draft.CaseNumber" Label="Expediente" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField T="string" Value="@draft.TypeName" Label="Tipo de trámite" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField T="string" Value="@draft.Channel" Label="Canal" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField T="string" Value="@draft.Applicant.Name" Label="Solicitante" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField T="string" Value="@draft.Object.Summary" Label="Objeto" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField T="string" Value="@draft.Department" Label="Departamento" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                                </MudGrid>
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">
                                    <MudChip T="string" Color="@GetStatusColor(draft.Status)" Variant="Variant.Outlined">@draft.Status</MudChip>
                                    <MudChip T="string" Color="@GetPriorityColor(draft.Priority)" Variant="Variant.Filled">@draft.Priority</MudChip>
                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@draft.Classification.TimeStatus</MudChip>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                        <ValidationStepSummary ValidationResults="@wizardState.ValidationResults" />
                    </MudStack>
                    break;
            }
        </ChildContent>
    </WizardShell>
</MudStack>

@code {
    private readonly WizardStateMockService wizardStateService = new();
    private readonly DraftMockService draftService = new();
    private readonly PlataformaServiciosMockService dataService = new();

    private WizardStateDto wizardState = new();
    private DraftStateDto draftState = new();
    private PsProcedureDto draft = new();
    private List<PsProcedureTypeDto> procedureTypes = new();
    private List<ProcessSummaryItemDto> processSummaryItems = new();
    private string selectedTypeCode = string.Empty;
    private string lastAuditEvent = "Aún no existen eventos";
    private string qualityStatus = "Pendiente";
    private string qualityObservation = "Revisión visual simulada.";
    private string qualityReturnReason = string.Empty;
    private string qualityResponsible = "Control de calidad demo";

    private readonly string[] channelOptions = [ "Presencial", "MIMUNIENCASA", "Portal municipal", "VUI", "Correo", "Teléfono", "Gestión interna" ];
    private readonly string[] priorityOptions = [ "Normal", "Alta", "Urgente" ];
    private readonly string[] initialStatuses = [ "Borrador", "Recibido", "En clasificación" ];
    private readonly string[] personTypes = [ "Física", "Jurídica" ];
    private readonly string[] notificationChannels = [ "Correo", "SMS", "Domicilio fiscal", "Plataforma digital" ];
    private readonly string[] moduleOptions = [ "RUC", "Bienes Inmuebles", "Patentes", "Permisos de Construcción", "Mercado Municipal", "Plataforma de Servicios" ];
    private readonly string[] departmentOptions = [ "Atención inicial", "Catastro", "Patentes", "Ingeniería", "Mercado", "Secretaría", "Tesorería", "Correspondencia" ];
    private readonly string[] requirementStatuses = [ "Presentado", "Pendiente", "Observado", "No aplica" ];
    private readonly string[] classificationStatuses = [ "Recibido", "En clasificación", "En revisión", "Trasladado", "En análisis", "Prevenido", "Resuelto", "Rechazado", "Archivado" ];
    private readonly string[] qualityStatuses = [ "Pendiente", "Aprobado", "Devuelto", "Reasignado" ];
    private readonly string[] deadlineStatuses = [ "En tiempo", "Próximo a vencer", "Vencido", "Suspendido" ];

    protected override async Task OnInitializedAsync()
    {
        procedureTypes = await dataService.GetProcedureTypesAsync();
        draft = CreateDraft(procedureTypes.FirstOrDefault());
        selectedTypeCode = draft.TypeCode;
        BuildWizardState();
        draftState = await draftService.MarkDirtyAsync(wizardState);
        wizardState.DraftState = draftState;
        RefreshSummary();
    }

    private void BuildWizardState()
    {
        var steps = new List<WizardStepDto>
        {
            new() { Id = "tipo", Index = 0, Order = 1, Title = "Tipo de trámite y canal", Description = "Clasificación inicial y recepción", Icon = Icons.Material.Filled.Category },
            new() { Id = "solicitante", Index = 1, Order = 2, Title = "Solicitante / contribuyente", Description = "Vínculo con RUC y notificación", Icon = Icons.Material.Filled.Person },
            new() { Id = "objeto", Index = 2, Order = 3, Title = "Objeto del trámite", Description = "Datos dinámicos según el trámite", Icon = Icons.Material.Filled.Description },
            new() { Id = "requisitos", Index = 3, Order = 4, Title = "Requisitos y documentos", Description = "Checklist mock de recepción", Icon = Icons.Material.Filled.Assignment },
            new() { Id = "clasificacion", Index = 4, Order = 5, Title = "Clasificación y departamento", Description = "Derivación y plazo", Icon = Icons.Material.Filled.SwapHoriz },
            new() { Id = "calidad", Index = 5, Order = 6, Title = "Validación y control de calidad", Description = "Revisión y retorno mock", Icon = Icons.Material.Filled.Verified },
            new() { Id = "resumen", Index = 6, Order = 7, Title = "Registro final", Description = "Confirmación y cierre demo", Icon = Icons.Material.Filled.DoneAll }
        };

        wizardState = wizardStateService.GetInitialState("Plataforma de Servicios", "Nuevo trámite", steps, draft.Id);
        wizardState.ProcessCode = draft.CaseNumber;
        wizardState.ProcessTitle = "Nuevo trámite";
        wizardState.ProcessName = "Trámite de ventanilla única";
        wizardState.CreatedBy = "demo.user";
        wizardState.Status = "Borrador";
        wizardState.DraftState.Status = "Borrador";
        wizardState.DraftState.SavedBy = "demo.user";
        wizardState.DraftState.Message = "Borrador preparado.";
        wizardState.ProcessSummaryItems = BuildProcessSummaryItems();
    }

    private PsProcedureDto CreateDraft(PsProcedureTypeDto? type)
    {
        var caseNumber = $"PS-{DateTime.Now:yyyy}-{DateTime.Now:HHmmss}";
        var selectedType = type ?? new PsProcedureTypeDto { Code = "PS-GEN", Name = "Solicitud general", ModuleName = "Plataforma de Servicios", Department = "Atención inicial", InitialStatus = "Borrador", Priority = "Normal", DeadlineDays = 10 };

        var procedure = new PsProcedureDto
        {
            Id = Guid.NewGuid().ToString("N"),
            CaseNumber = caseNumber,
            TypeCode = selectedType.Code,
            TypeName = selectedType.Name,
            ResolverModule = selectedType.ModuleName,
            Department = selectedType.Department,
            Priority = selectedType.Priority,
            Status = selectedType.InitialStatus,
            Channel = channelOptions.First(),
            Applicant = new PsApplicantDto
            {
                Identification = "1-2345-6789",
                Name = "Comercial Demo S.A.",
                PersonType = "Jurídica",
                Phone = "2222-1111",
                Email = "demo@comercial.cr",
                FiscalAddress = "San José centro",
                PreferredNotification = "Correo",
                RucStatus = "Validado",
                RucQuality = "Completo",
                ExistsInRuc = true
            },
            Object = new PsProcedureObjectDto { Kind = "General", Summary = "Objeto libre de trámite", OrigenSolicitud = "Presencial" },
            Requirements = BuildRequirements(selectedType),
            Classification = new PsClassificationDto
            {
                ModuleName = selectedType.ModuleName,
                DepartmentName = selectedType.Department,
                Responsible = "Funcionario demo",
                Team = "Equipo demo",
                Status = selectedType.InitialStatus,
                EstimatedDeadline = $"{selectedType.DeadlineDays} días",
                Priority = selectedType.Priority,
                TimeStatus = "En tiempo"
            },
            QualityControl = new PsQualityControlDto { Status = "Pendiente", Responsible = "Control de calidad demo", Observation = "Pendiente de revisión.", Action = "Recepción" },
            Resolution = new PsResolutionDto { Type = "Borrador", Responsible = "Secretaría demo", Status = "Borrador" },
            Deadline = new PsDeadlineDto { StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(selectedType.DeadlineDays), DaysRemaining = selectedType.DeadlineDays, Status = "En tiempo" },
            Integrations = new List<PsIntegrationStatusDto>
            {
                new() { Name = "RUC", Status = "Preparado", LastEvent = "Consulta mock", Description = "Referencia de contribuyente", ActionText = "Ver" },
                new() { Name = "Auditoría", Status = "Preparado", LastEvent = "Evento registrado", Description = "Trazabilidad demo", ActionText = "Ver" }
            },
            Notifications = new List<PsNotificationDto>(),
            History = new List<PsHistoryEventDto>(),
            AuditEvents = new List<PsAuditEventDto>(),
            Alerts = new List<string> { "Pendiente clasificación final." }
        };

        SyncProcedureByType(procedure, selectedType);
        return procedure;
    }

    private void SyncProcedureByType(PsProcedureDto procedure, PsProcedureTypeDto type)
    {
        procedure.TypeCode = type.Code;
        procedure.TypeName = type.Name;
        procedure.ResolverModule = type.ModuleName;
        procedure.Department = type.Department;
        procedure.Priority = type.Priority;
        procedure.Status = type.InitialStatus;
        procedure.Classification.ModuleName = type.ModuleName;
        procedure.Classification.DepartmentName = type.Department;
        procedure.Classification.Priority = type.Priority;
        procedure.Classification.EstimatedDeadline = $"{type.DeadlineDays} días";
        procedure.Classification.TimeStatus = "En tiempo";
        procedure.CaseNumber = string.IsNullOrWhiteSpace(procedure.CaseNumber) ? $"PS-{DateTime.Now:yyyy}-{DateTime.Now:HHmmss}" : procedure.CaseNumber;
        procedure.Object = GetObjectTemplate(type);
        procedure.Requirements = BuildRequirements(type);
        procedure.Deadline = new PsDeadlineDto { StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(type.DeadlineDays), DaysRemaining = type.DeadlineDays, Status = "En tiempo" };
        draft = procedure;
    }

    private PsProcedureObjectDto GetObjectTemplate(PsProcedureTypeDto type)
    {
        var obj = new PsProcedureObjectDto { Kind = "General", Summary = "Descripción libre del trámite." };

        if (type.RequiresFinca)
        {
            obj.Kind = "Finca";
            obj.IdPredial = "IDP-001";
            obj.NumeroFinca = "5-123456";
            obj.NumeroPlano = "PL-1020";
            obj.Distrito = "Central";
            obj.Propietario = "Contribuyente demo";
        }
        else if (type.RequiresPatent)
        {
            obj.Kind = "Patente";
            obj.NumeroLicencia = "PAT-2024-001";
            obj.NombreComercial = "Comercio demo";
            obj.ActividadEconomica = "Restaurante";
            obj.UsoSuelo = "Conforme";
        }
        else if (type.ModuleName.Contains("Construcción", StringComparison.OrdinalIgnoreCase))
        {
            obj.Kind = "Permiso de construcción";
            obj.NumeroFinca = "5-123456";
            obj.ProfesionalResponsable = "Ing. Demo";
            obj.TipoObra = "Ampliación";
            obj.Area = "120 m2";
            obj.MontoEstimado = "₡45,000,000";
        }
        else if (type.ModuleName.Contains("Mercado", StringComparison.OrdinalIgnoreCase))
        {
            obj.Kind = "Mercado Municipal";
            obj.NumeroLocal = "L-12";
            obj.Arrendatario = "Arrendatario demo";
            obj.Contrato = "CM-2025-011";
            obj.EstadoCuentaMock = "Al día";
        }
        else if (type.ModuleName.Equals("RUC", StringComparison.OrdinalIgnoreCase))
        {
            obj.Kind = "RUC";
            obj.TipoActualizacionRuc = "Cambio de dirección";
            obj.DatosAModificar = "Dirección fiscal y teléfono";
            obj.OrigenSolicitud = "Portal municipal";
        }

        return obj;
    }

    private List<PsRequirementDto> BuildRequirements(PsProcedureTypeDto type)
    {
        var items = new List<PsRequirementDto>
        {
            new() { Name = "Formulario de ingreso", Status = "Presentado", DocumentPlaceholder = "DOC-001", Receiver = "Recepción", Origin = "Plataforma de Servicios", ReceivedAt = DateTime.Now.AddDays(-1) },
            new() { Name = "Documento de identificación", Status = "Presentado", DocumentPlaceholder = "DOC-002", Receiver = "Recepción", Origin = "Presencial", ReceivedAt = DateTime.Now.AddDays(-1) },
            new() { Name = "Anexo complementario", Status = type.RequiresDocuments ? "Pendiente" : "No aplica", DocumentPlaceholder = "DOC-003", Receiver = "Recepción", Origin = "MIMUNIENCASA", Observation = type.RequiresDocuments ? "Pendiente de adjunto" : "No requerido" }
        };

        if (type.RequiresFinca)
        {
            items.Add(new PsRequirementDto { Name = "Constancia predial", Status = "Presentado", DocumentPlaceholder = "DOC-004", Receiver = "Recepción", Origin = "VUI", ReceivedAt = DateTime.Now.AddDays(-1) });
        }

        if (type.RequiresPatent)
        {
            items.Add(new PsRequirementDto { Name = "Uso de suelo", Status = "Observado", DocumentPlaceholder = "DOC-005", Receiver = "Recepción", Origin = "Plataforma de Servicios", Observation = "Validación mock pendiente" });
        }

        return items;
    }

    private async Task OnTypeChangedAsync(string value)
    {
        selectedTypeCode = value;
        var selected = procedureTypes.FirstOrDefault(item => item.Code == value) ?? procedureTypes.FirstOrDefault();
        if (selected is not null)
        {
            SyncProcedureByType(draft, selected);
        }

        wizardState.ProcessCode = draft.CaseNumber;
        wizardState.ProcessSummaryItems = BuildProcessSummaryItems();
        await Task.CompletedTask;
    }

    private async Task NextStepAsync()
    {
        var stepId = wizardState.CurrentStepId;
        var validations = ValidateCurrentStep();
        wizardState = await wizardStateService.UpdateStepValidationAsync(wizardState, stepId, validations);
        wizardState.PendingValidations = validations.Where(item => !item.IsValid).Select(item => item.Message).ToList();

        if (validations.Any(item => !item.IsValid && item.Severity == "Error"))
        {
            RefreshSummary();
            return;
        }

        wizardState = await wizardStateService.MarkStepCompletedAsync(wizardState, stepId);
        wizardState = await wizardStateService.GoNextAsync(wizardState);
        wizardState = await wizardStateService.SetStatusAsync(wizardState, "En progreso");
        RefreshSummary();
    }

    private async Task PreviousStepAsync()
    {
        wizardState = await wizardStateService.GoPreviousAsync(wizardState);
        RefreshSummary();
    }

    private async Task SaveDraftAsync()
    {
        wizardState.IsDirty = true;
        wizardState = await wizardStateService.SaveDraftAsync(wizardState);
        draftState = await draftService.SaveDraftAsync(wizardState, draft);
        draftState.Message = "Borrador de trámite guardado correctamente.";
        draftState.SavedBy = "demo.user";
        draftState.HasUnsavedChanges = false;
        wizardState.DraftState = draftState;
        wizardState.LastSavedAt = draftState.LastSavedAt;
        lastAuditEvent = $"Borrador guardado a las {DateTime.Now:HH:mm}.";
        RefreshSummary();
    }

    private async Task CancelAsync()
    {
        wizardState = await wizardStateService.SetStatusAsync(wizardState, "Cancelado");
        NavigationManager.NavigateTo("/plataforma-servicios");
    }

    private Task GoBackToIndexAsync()
    {
        NavigationManager.NavigateTo("/plataforma-servicios");
        return Task.CompletedTask;
    }

    private async Task FinishAsync()
    {
        var allValidations = new List<StepValidationResultDto>();
        for (var index = 0; index < wizardState.Steps.Count; index++)
        {
            wizardState.CurrentStepIndex = index;
            wizardState.CurrentStepId = wizardState.Steps[index].Id;
            var validations = ValidateCurrentStep();
            allValidations.AddRange(validations);
            wizardState = await wizardStateService.UpdateStepValidationAsync(wizardState, wizardState.CurrentStepId, validations);
            if (validations.Any(item => !item.IsValid && item.Severity == "Error"))
            {
                wizardState = await wizardStateService.SetStatusAsync(wizardState, "Pendiente validación");
                wizardState.PendingValidations = allValidations.Where(item => !item.IsValid).Select(item => item.Message).ToList();
                RefreshSummary();
                return;
            }
        }

        draft.Status = "Recibido";
        draft.History.Insert(0, new PsHistoryEventDto
        {
            Date = DateTime.Now,
            User = "demo.user",
            Action = "Registro final",
            PreviousStatus = "Borrador",
            NewStatus = "Recibido",
            Department = draft.Department,
            Comment = "Registro confirmado desde el wizard demo.",
            Origin = "Plataforma de Servicios"
        });
        draft.AuditEvents.Insert(0, new PsAuditEventDto { Action = "Registro final", Description = $"Expediente {draft.CaseNumber} creado desde Plataforma de Servicios.", Severity = "Success" });

        var created = await dataService.RegisterProcedureAsync(draft);
        wizardState = await wizardStateService.SetStatusAsync(wizardState, "Completado");
        lastAuditEvent = $"Expediente {created.CaseNumber} registrado correctamente en modo demo.";
        NavigationManager.NavigateTo($"/plataforma-servicios/expediente/{created.Id}");
    }

    private List<StepValidationResultDto> ValidateCurrentStep()
    {
        var stepId = wizardState.CurrentStepId;
        var results = new List<StepValidationResultDto>();

        if (stepId == "tipo")
        {
            results.Add(BuildResult(stepId, "Tipo de trámite", "El tipo de trámite es obligatorio.", "Error", !string.IsNullOrWhiteSpace(draft.TypeCode), "PS-001"));
            results.Add(BuildResult(stepId, "Canal", "El canal de ingreso es obligatorio.", "Error", !string.IsNullOrWhiteSpace(draft.Channel), "PS-002"));
            results.Add(BuildResult(stepId, "Departamento", "El departamento sugerido es obligatorio.", "Error", !string.IsNullOrWhiteSpace(draft.Department), "PS-003"));
        }
        else if (stepId == "solicitante")
        {
            results.Add(BuildResult(stepId, "Identificación", "La identificación es obligatoria.", "Error", !string.IsNullOrWhiteSpace(draft.Applicant.Identification), "PS-010"));
            results.Add(BuildResult(stepId, "Nombre", "El nombre o razón social es obligatorio.", "Error", !string.IsNullOrWhiteSpace(draft.Applicant.Name), "PS-011"));
            results.Add(BuildResult(stepId, "Medio de notificación", "Se recomienda definir un medio de notificación.", "Warning", !string.IsNullOrWhiteSpace(draft.Applicant.PreferredNotification), "PS-012"));
            results.Add(BuildResult(stepId, "RUC", "El contribuyente puede continuar como pendiente validar RUC.", "Info", draft.Applicant.ExistsInRuc || !string.IsNullOrWhiteSpace(draft.Applicant.RucStatus), "PS-013"));
        }
        else if (stepId == "objeto")
        {
            results.Add(BuildResult(stepId, "Objeto", "El objeto debe estar completo para continuar.", "Error", !string.IsNullOrWhiteSpace(draft.Object.Summary), "PS-020"));
            if (RequiresFinca())
            {
                results.Add(BuildResult(stepId, "Finca", "Debe indicar el ID predial o la finca.", "Error", !string.IsNullOrWhiteSpace(draft.Object.IdPredial) || !string.IsNullOrWhiteSpace(draft.Object.NumeroFinca), "PS-021"));
            }
            if (RequiresPatent())
            {
                results.Add(BuildResult(stepId, "Patente", "Debe indicar la licencia comercial.", "Error", !string.IsNullOrWhiteSpace(draft.Object.NumeroLicencia), "PS-022"));
            }
        }
        else if (stepId == "requisitos")
        {
            results.AddRange(draft.Requirements.Select(item =>
                BuildResult(stepId, item.Name, item.Status == "Pendiente" ? "Existe al menos un requisito pendiente." : item.Status == "Observado" ? "Requisito observado en modo mock." : "Requisito presentado.", item.Status == "Pendiente" || item.Status == "Observado" ? "Warning" : "Success", true, $"PS-03{draft.Requirements.IndexOf(item)}")));
        }
        else if (stepId == "clasificacion")
        {
            results.Add(BuildResult(stepId, "Departamento", "Debe existir un departamento asignado.", "Error", !string.IsNullOrWhiteSpace(draft.Classification.DepartmentName), "PS-030"));
            results.Add(BuildResult(stepId, "Responsable", "Debe existir un responsable mock.", "Warning", !string.IsNullOrWhiteSpace(draft.Classification.Responsible), "PS-031"));
        }
        else if (stepId == "calidad")
        {
            results.Add(BuildResult(stepId, "Control de calidad", "Estado de control de calidad registrado.", qualityStatus == "Aprobado" ? "Success" : qualityStatus == "Devuelto" ? "Warning" : "Info", true, "PS-040"));
        }
        else if (stepId == "resumen")
        {
            results.Add(BuildResult(stepId, "Resumen", "Revise el resumen antes de finalizar.", "Info", true, "PS-050"));
        }

        return results;
    }

    private static StepValidationResultDto BuildResult(string stepId, string field, string message, string severity, bool isValid, string code)
        => new()
        {
            StepId = stepId,
            Field = field,
            Message = message,
            Severity = severity,
            IsValid = isValid,
            Code = code
        };

    private void RefreshSummary()
    {
        wizardState.ProcessSummaryItems = BuildProcessSummaryItems();
        wizardState.TotalSteps = wizardState.Steps.Count;
        wizardState.ProcessId = draft.Id;
        wizardState.ProcessCode = draft.CaseNumber;
        wizardState.ProcessName = "Trámite de ventanilla única";
        wizardState.ModuleName = "Plataforma de Servicios";
        wizardState.DraftState = draftState;
        wizardState.DraftState.Status = draftState.Status;
    }

    private List<ProcessSummaryItemDto> BuildProcessSummaryItems()
    {
        return new List<ProcessSummaryItemDto>
        {
            new() { Label = "Expediente", Value = draft.CaseNumber, Icon = Icons.Material.Filled.Badge, Severity = "Info", Group = "General" },
            new() { Label = "Tipo", Value = draft.TypeName, Icon = Icons.Material.Filled.Category, Severity = "Info", Group = "General" },
            new() { Label = "Canal", Value = draft.Channel, Icon = Icons.Material.Filled.Route, Severity = "Info", Group = "General" },
            new() { Label = "Solicitante", Value = draft.Applicant.Name, Icon = Icons.Material.Filled.Person, Severity = "Success", Group = "Solicitante" },
            new() { Label = "Identificación", Value = draft.Applicant.Identification, Icon = Icons.Material.Filled.Badge, Severity = "Success", Group = "Solicitante" },
            new() { Label = "Módulo resolutor", Value = draft.ResolverModule, Icon = Icons.Material.Filled.Hub, Severity = "Info", Group = "Clasificación" },
            new() { Label = "Departamento", Value = draft.Department, Icon = Icons.Material.Filled.Apartment, Severity = "Info", Group = "Clasificación" },
            new() { Label = "Prioridad", Value = draft.Priority, Icon = Icons.Material.Filled.PriorityHigh, Severity = "Warning", Group = "Clasificación" },
            new() { Label = "Estado RUC", Value = draft.Applicant.RucStatus, Icon = Icons.Material.Filled.AccountBox, Severity = draft.Applicant.ExistsInRuc ? "Success" : "Warning", Group = "Solicitante" },
            new() { Label = "Plazo", Value = draft.Deadline.Status, Icon = Icons.Material.Filled.Schedule, Severity = draft.Deadline.Status == "Vencido" ? "Error" : "Info", Group = "Plazos" }
        };
    }

    private string GetCurrentStepTitle() => wizardState.Steps.FirstOrDefault(item => item.Index == wizardState.CurrentStepIndex)?.Title ?? "Nuevo trámite";
    private string GetCurrentStepSubtitle() => wizardState.Steps.FirstOrDefault(item => item.Index == wizardState.CurrentStepIndex)?.Description ?? string.Empty;
    private string GetNextSuggestedStep() => wizardState.CurrentStepIndex < wizardState.Steps.Count - 1 ? wizardState.Steps[wizardState.CurrentStepIndex + 1].Title : "Finalizar registro";
    private bool CanGoBack => wizardState.CurrentStepIndex > 0;
    private bool CanGoNext => wizardState.CurrentStepIndex < wizardState.Steps.Count - 1;
    private bool CanFinish => wizardState.CurrentStepIndex == wizardState.Steps.Count - 1;

    private bool RequiresFinca() => procedureTypes.FirstOrDefault(item => item.Code == selectedTypeCode)?.RequiresFinca == true;
    private bool RequiresPatent() => procedureTypes.FirstOrDefault(item => item.Code == selectedTypeCode)?.RequiresPatent == true;
    private bool RequiresConstruction() => procedureTypes.FirstOrDefault(item => item.Code == selectedTypeCode)?.ModuleName.Contains("Construcción", StringComparison.OrdinalIgnoreCase) == true;
    private bool RequiresMarket() => procedureTypes.FirstOrDefault(item => item.Code == selectedTypeCode)?.ModuleName.Contains("Mercado", StringComparison.OrdinalIgnoreCase) == true;
    private bool RequiresRuc() => procedureTypes.FirstOrDefault(item => item.Code == selectedTypeCode)?.ModuleName.Equals("RUC", StringComparison.OrdinalIgnoreCase) == true;

    private async Task SearchRucAsync() { lastAuditEvent = "Búsqueda RUC simulada."; Snackbar.Add("Búsqueda RUC simulada.", Severity.Info); await Task.CompletedTask; }
    private async Task ViewRucAsync() { Snackbar.Add("Vista RUC referencial no disponible en backend real.", Severity.Info); await Task.CompletedTask; }
    private async Task CreateApplicantAsync() { Snackbar.Add("Creación de contribuyente solo como referencia visual.", Severity.Info); await Task.CompletedTask; }
    private async Task ViewRelatedAsync() { Snackbar.Add("Vínculo relacionado abierto en modo demo.", Severity.Info); await Task.CompletedTask; }
    private async Task OnRequirementStatusChangedAsync(PsRequirementDto requirement, string value) { requirement.Status = value; await Task.CompletedTask; }
    private async Task UpdateRequirementAsync(PsRequirementDto requirement, string status) { requirement.Status = status; requirement.ReceivedAt = DateTime.Now; requirement.Receiver = "Recepción demo"; Snackbar.Add($"Requisito '{requirement.Name}' actualizado a {status}.", Severity.Info); await Task.CompletedTask; }
    private async Task ViewDocumentAsync(PsRequirementDto requirement) { Snackbar.Add($"Documento mock: {requirement.DocumentPlaceholder}", Severity.Info); await Task.CompletedTask; }
    private Task MarkRequirementPresentedAsync(PsRequirementDto requirement) => UpdateRequirementAsync(requirement, "Presentado");
    private Task MarkRequirementPendingAsync(PsRequirementDto requirement) => UpdateRequirementAsync(requirement, "Pendiente");
    private Task MarkRequirementObservedAsync(PsRequirementDto requirement) => UpdateRequirementAsync(requirement, "Observado");
    private async Task TransferMockAsync() { Snackbar.Add("Traslado mock generado.", Severity.Info); await Task.CompletedTask; }
    private async Task AssignResponsibleMockAsync() { Snackbar.Add("Responsable mock asignado.", Severity.Info); await Task.CompletedTask; }
    private async Task ChangePriorityMockAsync() { Snackbar.Add("Prioridad mock actualizada.", Severity.Info); await Task.CompletedTask; }
    private async Task ApproveReceptionAsync() { qualityStatus = "Aprobado"; Snackbar.Add("Control de calidad aprobado en modo demo.", Severity.Success); await Task.CompletedTask; }
    private async Task ReturnProcedureAsync() { qualityStatus = "Devuelto"; Snackbar.Add("El trámite fue devuelto en modo demo.", Severity.Warning); await Task.CompletedTask; }
    private async Task ReassignAsync() { qualityStatus = "Reasignado"; Snackbar.Add("El trámite fue reasignado en modo demo.", Severity.Info); await Task.CompletedTask; }
    private async Task ContinueAsync() { Snackbar.Add("Continuación disponible en el siguiente paso.", Severity.Info); await Task.CompletedTask; }

    private Color GetValidationColor(bool isValid) => isValid ? Color.Success : Color.Warning;
    private Color GetPriorityColor(string priority) => priority == "Urgente" ? Color.Error : priority == "Alta" ? Color.Warning : Color.Info;
    private bool IsApplicantReady()
        => !string.IsNullOrWhiteSpace(draft.Applicant.Identification)
            && !string.IsNullOrWhiteSpace(draft.Applicant.Name);

    private bool IsRucReady()
        => draft.Applicant.ExistsInRuc || !string.IsNullOrWhiteSpace(draft.Applicant.RucStatus);

    private bool IsObjectReady()
    {
        if (string.IsNullOrWhiteSpace(draft.Object.Summary))
        {
            return false;
        }

        if (RequiresFinca())
        {
            return !string.IsNullOrWhiteSpace(draft.Object.IdPredial) || !string.IsNullOrWhiteSpace(draft.Object.NumeroFinca);
        }

        if (RequiresPatent())
        {
            return !string.IsNullOrWhiteSpace(draft.Object.NumeroLicencia);
        }

        if (RequiresConstruction())
        {
            return !string.IsNullOrWhiteSpace(draft.Object.NumeroFinca)
                && !string.IsNullOrWhiteSpace(draft.Object.TipoObra);
        }

        if (RequiresMarket())
        {
            return !string.IsNullOrWhiteSpace(draft.Object.NumeroLocal);
        }

        if (RequiresRuc())
        {
            return !string.IsNullOrWhiteSpace(draft.Object.TipoActualizacionRuc);
        }

        return true;
    }

    private bool IsRequirementsReady()
        => draft.Requirements.All(item => item.Status is "Presentado" or "No aplica");

    private Color GetTimeColor(string status) => status == "Vencido" ? Color.Error : status == "Próximo a vencer" ? Color.Warning : Color.Success;
    private Color GetStatusColor(string status) => status == "Recibido" || status == "Resuelto" || status == "Archivado" ? Color.Success : status == "Prevenido" || status == "Borrador" ? Color.Warning : status == "Rechazado" ? Color.Error : Color.Info;

}