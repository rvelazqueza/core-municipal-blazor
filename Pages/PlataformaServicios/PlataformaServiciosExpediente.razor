@page "/plataforma-servicios/expediente/{Id}"
@using System
@using System.Collections.Generic
@using System.Linq
@using BlazorApp.Models.PlataformaServicios
@using BlazorApp.Services.PlataformaServicios
@using BlazorApp.Shared
@using MudBlazor
@using BlazorApp.Helpers
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject DocumentExportHelper ExportHelper

<PageTitleBar Title="Expediente de trámite"
              Subtitle="Vista 360° del expediente con secciones para consulta y edición del proceso municipal.">
    <Actions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBackAsync">Volver</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">Editar trámite</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintDocumentAsync">Imprimir</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="ExportPdfAsync">Generar PDF</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Html" OnClick="ExportHtmlAsync">Exportar HTML</MudButton>
    </Actions>
</PageTitleBar>

@if (procedure is null)
{
    <EmptyState Title="Expediente no encontrado" Description="El expediente solicitado no existe en la información disponible." Icon="@Icons.Material.Filled.SearchOff" />
}
else
{
    <MudStack Spacing="3">
        <MudAlert Severity="@GetDeadlineSeverity()" Variant="Variant.Outlined">
            @GetAlertMessage()
        </MudAlert>

        <MudTabs Outlined="true" Rounded="true" Border="true" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="activeTab" PanelClass="pa-4">
            <MudTabPanel Text="Resumen 360°" Icon="@Icons.Material.Filled.SpaceDashboard">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="4"><KpiCard Title="Expediente" Value="@procedure.CaseNumber" Subtitle="Número de expediente" Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" md="4"><KpiCard Title="Estado" Value="@procedure.Status" Subtitle="Estado operativo actual" Icon="@Icons.Material.Filled.Flag" Color="@GetStatusColor(procedure.Status)" /></MudItem>
                    <MudItem xs="12" md="4"><KpiCard Title="Plazo" Value="@procedure.Deadline.Status" Subtitle="Seguimiento del plazo" Icon="@Icons.Material.Filled.Schedule" Color="@GetDeadlineColor(procedure.Deadline.Status)" /></MudItem>
                </MudGrid>
                <MudGrid Spacing="3" Class="mt-2">
                    <MudItem xs="12" md="8">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Alertas y acciones rápidas</MudText>
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                    @foreach (var alert in procedure.Alerts)
                                    {
                                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@alert</MudChip>
                                    }
                                    <MudChip T="string" Color="@GetDeadlineColor(procedure.Deadline.Status)" Variant="Variant.Outlined">@procedure.Deadline.Status</MudChip>
                                    <MudChip T="string" Color="@GetStatusColor(procedure.Status)" Variant="Variant.Outlined">@procedure.Status</MudChip>
                                </MudStack>
                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="ShowTransferAsync">Trasladar</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ReportProblem" OnClick="ShowPreventionAsync">Prevenir</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.TaskAlt" OnClick="ShowResolutionAsync">Resolver</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Notifications" OnClick="ShowNotificationAsync">Notificar</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.History" OnClick="@(() => activeTab = 12)">Ver auditoría</MudButton>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Resumen operativo</MudText>
                                <MudText Typo="Typo.body2">Canal: @procedure.Channel</MudText>
                                <MudText Typo="Typo.body2">Solicitante: @procedure.Applicant.Name</MudText>
                                <MudText Typo="Typo.body2">Módulo resolutor: @procedure.ResolverModule</MudText>
                                <MudText Typo="Typo.body2">Departamento: @procedure.Department</MudText>
                                <MudText Typo="Typo.body2">Responsable: @procedure.Responsible</MudText>
                                <MudProgressLinear Value="@GetProgress()" Color="@GetDeadlineColor(procedure.Deadline.Status)" Rounded="true" Class="mt-3" />
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Datos generales" Icon="@Icons.Material.Filled.Info">
                <MudCard Outlined="true">
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.CaseNumber" Label="Número de expediente" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.TypeCode" Label="Código del trámite" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.TypeName" Label="Tipo de trámite" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Channel" Label="Canal" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@FormatDate(procedure.EntryDate)" Label="Fecha de ingreso" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Responsible" Label="Funcionario responsable" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Department" Label="Departamento asignado" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Priority" Label="Prioridad" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@FormatDate(procedure.LimitDate)" Label="Fecha límite" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>

            <MudTabPanel Text="Solicitante" Icon="@Icons.Material.Filled.Person">
                <MudCard Outlined="true">
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Applicant.Identification" Label="Identificación" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Applicant.Name" Label="Nombre o razón social" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Applicant.PersonType" Label="Tipo de persona" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Applicant.Phone" Label="Teléfono" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Applicant.Email" Label="Correo" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Applicant.PreferredNotification" Label="Medio de notificación" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="12"><MudTextField T="string" Value="@procedure.Applicant.FiscalAddress" Label="Dirección fiscal" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                        </MudGrid>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">
                            <MudChip T="string" Color="@(procedure.Applicant.ExistsInRuc ? Color.Success : Color.Warning)" Variant="Variant.Outlined">@procedure.Applicant.RucStatus</MudChip>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@procedure.Applicant.RucQuality</MudChip>
                        </MudStack>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Badge" OnClick="ShowRucAsync">Ver RUC</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ValidateRucAsync">Validar RUC</MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>

            <MudTabPanel Text="Objeto del trámite" Icon="@Icons.Material.Filled.Description">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">@procedure.Object.Kind</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@procedure.Object.Summary</MudText>
                                <MudDivider Class="my-3" />
                                @if (!string.IsNullOrWhiteSpace(procedure.Object.IdPredial))
                                {
                                    <MudText Typo="Typo.body2">ID Predial: @procedure.Object.IdPredial</MudText>
                                    <MudText Typo="Typo.body2">Finca: @procedure.Object.NumeroFinca</MudText>
                                    <MudText Typo="Typo.body2">Plano: @procedure.Object.NumeroPlano</MudText>
                                    <MudText Typo="Typo.body2">Distrito: @procedure.Object.Distrito</MudText>
                                }
                                @if (!string.IsNullOrWhiteSpace(procedure.Object.NumeroLicencia))
                                {
                                    <MudText Typo="Typo.body2">Número de licencia: @procedure.Object.NumeroLicencia</MudText>
                                    <MudText Typo="Typo.body2">Nombre comercial: @procedure.Object.NombreComercial</MudText>
                                    <MudText Typo="Typo.body2">Actividad económica: @procedure.Object.ActividadEconomica</MudText>
                                }
                                @if (!string.IsNullOrWhiteSpace(procedure.Object.NumeroLocal))
                                {
                                    <MudText Typo="Typo.body2">Número de local: @procedure.Object.NumeroLocal</MudText>
                                    <MudText Typo="Typo.body2">Arrendatario: @procedure.Object.Arrendatario</MudText>
                                    <MudText Typo="Typo.body2">Contrato: @procedure.Object.Contrato</MudText>
                                }
                                @if (!string.IsNullOrWhiteSpace(procedure.Object.TipoActualizacionRuc))
                                {
                                    <MudText Typo="Typo.body2">Tipo de actualización: @procedure.Object.TipoActualizacionRuc</MudText>
                                    <MudText Typo="Typo.body2">Datos a modificar: @procedure.Object.DatosAModificar</MudText>
                                    <MudText Typo="Typo.body2">Origen: @procedure.Object.OrigenSolicitud</MudText>
                                }
                                @if (!string.IsNullOrWhiteSpace(procedure.Object.ProfesionalResponsable))
                                {
                                    <MudText Typo="Typo.body2">Profesional responsable: @procedure.Object.ProfesionalResponsable</MudText>
                                    <MudText Typo="Typo.body2">Tipo de obra: @procedure.Object.TipoObra</MudText>
                                    <MudText Typo="Typo.body2">Área: @procedure.Object.Area</MudText>
                                    <MudText Typo="Typo.body2">Monto estimado: @procedure.Object.MontoEstimado</MudText>
                                }
                                <MudButton Class="mt-3" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenRelatedModuleAsync">Ir al módulo relacionado</MudButton>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Alertas del objeto</MudText>
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                    @foreach (var alert in procedure.Alerts)
                                    {
                                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@alert</MudChip>
                                    }
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Requisitos y documentos" Icon="@Icons.Material.Filled.Assignment">
                <MudTable T="PsRequirementDto" Items="@procedure.Requirements" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Requisito</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Documento</MudTh>
                        <MudTh>Observación</MudTh>
                        <MudTh>Origen</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Requisito">@context.Name</MudTd>
                        <MudTd DataLabel="Estado"><MudChip T="string" Size="Size.Small" Color="@GetRequirementColor(context.Status)" Variant="Variant.Outlined">@context.Status</MudChip></MudTd>
                        <MudTd DataLabel="Documento">@context.DocumentPlaceholder</MudTd>
                        <MudTd DataLabel="Observación">@context.Observation</MudTd>
                        <MudTd DataLabel="Origen">@context.Origin</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Análisis y control" Icon="@Icons.Material.Filled.Checklist">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Análisis técnico</MudText>
                                <MudText Typo="Typo.body2">Criterio técnico: @procedure.QualityControl.Action</MudText>
                                <MudText Typo="Typo.body2">Resultado preliminar: @procedure.QualityControl.Status</MudText>
                                <MudText Typo="Typo.body2">Responsable: @procedure.QualityControl.Responsible</MudText>
                                <MudText Typo="Typo.body2">Observación: @procedure.QualityControl.Observation</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Control de calidad</MudText>
                                <MudChip T="string" Color="@GetQualityColor(procedure.QualityControl.Status)" Variant="Variant.Outlined">@procedure.QualityControl.Status</MudChip>
                                <MudText Typo="Typo.body2" Class="mt-2">Motivo de devolución: @procedure.QualityControl.ReturnReason</MudText>
                                <MudText Typo="Typo.body2">Fecha: @(procedure.QualityControl.Date?.ToString("dd/MM/yyyy") ?? "N/A")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Traslados internos" Icon="@Icons.Material.Filled.SwapHoriz">
                <MudTable T="PsTransferDto" Items="@procedure.Transfers" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Origen</MudTh>
                        <MudTh>Destino</MudTh>
                        <MudTh>Motivo</MudTh>
                        <MudTh>Estado</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Origen">@context.OriginDepartment</MudTd>
                        <MudTd DataLabel="Destino">@context.DestinationDepartment</MudTd>
                        <MudTd DataLabel="Motivo">@context.Reason</MudTd>
                        <MudTd DataLabel="Estado">@context.Status</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Resoluciones" Icon="@Icons.Material.Filled.TaskAlt">
                <MudCard Outlined="true">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1">Resolución</MudText>
                        <MudText Typo="Typo.body2">Tipo: @procedure.Resolution.Type</MudText>
                        <MudText Typo="Typo.body2">Estado: @procedure.Resolution.Status</MudText>
                        <MudText Typo="Typo.body2">Responsable: @procedure.Resolution.Responsible</MudText>
                        <MudText Typo="Typo.body2">Firma digital: @procedure.Resolution.DigitalSignatureReference</MudText>
                        <MudText Typo="Typo.body2">PDF: @procedure.Resolution.PdfReference</MudText>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateResolutionAsync">Generar resolución</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="ViewResolutionAsync">Ver resolución</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="SendToSignatureAsync">Enviar a firma</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="NotifyResolutionAsync">Notificar</MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>

            <MudTabPanel Text="Notificaciones" Icon="@Icons.Material.Filled.Notifications">
                <MudTable T="PsNotificationDto" Items="@procedure.Notifications" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Medio</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Resultado</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tipo">@context.Type</MudTd>
                        <MudTd DataLabel="Medio">@context.Channel</MudTd>
                        <MudTd DataLabel="Estado"><MudChip T="string" Size="Size.Small" Color="@GetNotificationColor(context.Status)" Variant="Variant.Outlined">@context.Status</MudChip></MudTd>
                        <MudTd DataLabel="Resultado">@context.Result</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Plazos" Icon="@Icons.Material.Filled.Schedule">
                <MudCard Outlined="true">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1">Plazos</MudText>
                        <MudProgressLinear Value="@GetProgress()" Color="@GetDeadlineColor(procedure.Deadline.Status)" Rounded="true" Class="my-3" />
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@FormatDate(procedure.Deadline.StartDate)" Label="Fecha de ingreso" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@FormatDate(procedure.Deadline.EndDate)" Label="Fecha límite" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField T="string" Value="@procedure.Deadline.Status" Label="Estado de plazo" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>

            <MudTabPanel Text="Integraciones" Icon="@Icons.Material.Filled.Hub">
                <MudGrid Spacing="2">
                    @foreach (var integration in procedure.Integrations)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Outlined="true" Class="h-100">
                                <MudCardContent>
                                    <div class="d-flex justify-space-between gap-2">
                                        <MudText Typo="Typo.subtitle2">@integration.Name</MudText>
                                        <MudChip T="string" Color="@GetIntegrationColor(integration.Status)" Variant="Variant.Outlined">@integration.Status</MudChip>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="mt-2">@integration.Description</MudText>
                                    <MudText Typo="Typo.caption">@integration.LastEvent</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Historial" Icon="@Icons.Material.Filled.History">
                <MudTable T="PsHistoryEventDto" Items="@procedure.History" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Usuario</MudTh>
                        <MudTh>Acción</MudTh>
                        <MudTh>Estado anterior</MudTh>
                        <MudTh>Estado nuevo</MudTh>
                        <MudTh>Departamento</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha">@context.Date.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Usuario">@context.User</MudTd>
                        <MudTd DataLabel="Acción">@context.Action</MudTd>
                        <MudTd DataLabel="Estado anterior">@context.PreviousStatus</MudTd>
                        <MudTd DataLabel="Estado nuevo">@context.NewStatus</MudTd>
                        <MudTd DataLabel="Departamento">@context.Department</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Auditoría" Icon="@Icons.Material.Filled.Policy">
                <MudTable T="PsAuditEventDto" Items="@procedure.AuditEvents" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Usuario</MudTh>
                        <MudTh>Acción</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh>Severidad</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha">@context.CreatedAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Usuario">@context.User</MudTd>
                        <MudTd DataLabel="Acción">@context.Action</MudTd>
                        <MudTd DataLabel="Descripción">@context.Description</MudTd>
                        <MudTd DataLabel="Severidad"><MudChip T="string" Size="Size.Small" Color="@GetAuditColor(context.Severity)" Variant="Variant.Outlined">@context.Severity</MudChip></MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Reportes" Icon="@Icons.Material.Filled.Assessment">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">Reportes relacionados</MudText>
                                <MudStack Spacing="1" Class="mt-2">
                                    @foreach (var report in reportSummaries)
                                    {
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@report</MudChip>
                                    }
                                </MudStack>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportMockAsync">Exportar</MudButton>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Inject] private PlataformaServiciosMockService mockService { get; set; } = default!;

    private PsProcedureDto? procedure;
    private int activeTab;
    private readonly List<string> reportSummaries = new()
    {
        "Trámites por estado",
        "Trámites por departamento",
        "Trámites por canal",
        "Trámites vencidos",
        "Resoluciones emitidas",
        "Notificaciones",
        "Productividad",
        "Integraciones"
    };

    protected override async Task OnParametersSetAsync()
    {
        procedure = await mockService.GetProcedureAsync(Id);
        activeTab = 0;
    }

    private async Task EditAsync()
    {
        Snackbar.Add("Edición disponible desde el expediente consultado.", Severity.Info);
        await Task.CompletedTask;
    }

    private Task ShowTransferAsync() => NotifyAsync("Traslado ejecutado.", Severity.Info);
    private Task ShowPreventionAsync() => NotifyAsync("Prevención generada.", Severity.Warning);
    private Task ShowResolutionAsync() => NotifyAsync("Resolución generada.", Severity.Success);
    private Task ShowNotificationAsync() => NotifyAsync("Notificación generada.", Severity.Info);
    private Task ShowRucAsync() => NotifyAsync("Vista RUC disponible.", Severity.Info);
    private Task ValidateRucAsync() => NotifyAsync("Validación RUC completada.", Severity.Info);
    private Task OpenRelatedModuleAsync() => NotifyAsync("Vínculo visual al módulo relacionado.", Severity.Info);
    private Task GenerateResolutionAsync() => NotifyAsync("Resolución generada.", Severity.Success);
    private Task ViewResolutionAsync() => NotifyAsync("Resolución abierta.", Severity.Info);
    private Task SendToSignatureAsync() => NotifyAsync("Firma solicitada.", Severity.Warning);
    private Task NotifyResolutionAsync() => NotifyAsync("Notificación enviada.", Severity.Success);
    private Task ExportMockAsync() => NotifyAsync("Exportación disponible en implementación backend.", Severity.Warning);

    private Task NotifyAsync(string message, Severity severity)
    {
        Snackbar.Add(message, severity);
        return Task.CompletedTask;
    }

    private Task GoBackAsync()
    {
        NavigationManager.NavigateTo("/plataforma-servicios");
        return Task.CompletedTask;
    }

    private string GetAlertMessage()
        => procedure!.Deadline.Status == "Vencido" ? "El expediente se encuentra vencido." :
           procedure!.Deadline.Status == "Próximo a vencer" ? "El expediente está próximo a vencer." :
           procedure!.Alerts.FirstOrDefault() ?? "El expediente se encuentra en seguimiento normal.";

    private Severity GetDeadlineSeverity()
        => procedure!.Deadline.Status == "Vencido" ? Severity.Error : procedure!.Deadline.Status == "Próximo a vencer" ? Severity.Warning : Severity.Info;

    private double GetProgress() => procedure is null ? 0 : Math.Min(100, Math.Max(5, procedure.Requirements.Count == 0 ? 25 : procedure.Requirements.Count(item => item.Status == "Presentado") * 100.0 / procedure.Requirements.Count));

    private Color GetStatusColor(string status)
        => status is "Resuelto" or "Archivado" ? Color.Success : status is "Prevenido" ? Color.Warning : status is "Vencido" ? Color.Error : Color.Info;

    private Color GetDeadlineColor(string status)
        => status is "Vencido" ? Color.Error : status is "Próximo a vencer" ? Color.Warning : Color.Success;

    private Color GetRequirementColor(string status)
        => status is "Presentado" ? Color.Success : status is "Observado" ? Color.Warning : status is "No aplica" ? Color.Info : Color.Error;

    private Color GetQualityColor(string status)
        => status is "Aprobado" ? Color.Success : status is "Devuelto" ? Color.Warning : status is "Reasignado" ? Color.Info : Color.Info;

    private Color GetNotificationColor(string status)
        => status is "Enviada" ? Color.Success : status is "Fallida" ? Color.Error : Color.Warning;

    private Color GetIntegrationColor(string status)
        => status is "Preparado" ? Color.Success : status is "Procesado" ? Color.Info : Color.Warning;

    private Color GetAuditColor(string severity)
        => severity is "Success" ? Color.Success : severity is "Warning" ? Color.Warning : Color.Info;

    private static string FormatDate(DateTime date) => date.ToString("dd/MM/yyyy");

    private async Task ExportHtmlAsync()
    {
        var content = BuildProcedureDocument();
        var fileName = $"Tramite_{procedure.CaseNumber}.html";
        await ExportHelper.ExportAsHtmlAsync(content, fileName);
    }

    private async Task PrintDocumentAsync()
    {
        var content = BuildProcedureDocument();
        await ExportHelper.PrintHtmlAsync(content);
    }

    private async Task ExportPdfAsync()
    {
        var content = BuildProcedureDocument();
        var fileName = $"Tramite_{procedure.CaseNumber}.pdf";
        await ExportHelper.ExportAsPdfAsync(content, fileName);
    }

    private string BuildProcedureDocument()
    {
        var sb = new System.Text.StringBuilder();

        sb.Append("<div class='section'>");
        sb.Append("<div class='section-title'>Información General</div>");
        sb.AppendFormat("<div class='field'><span class='field-label'>Número de expediente:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.CaseNumber));
        sb.AppendFormat("<div class='field'><span class='field-label'>Tipo de trámite:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.TypeName));
        sb.AppendFormat("<div class='field'><span class='field-label'>Canal:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Channel));
        sb.AppendFormat("<div class='field'><span class='field-label'>Estado:</span><span class='field-value'><span class='badge badge-info'>{0}</span></span></div>", DocumentExportHelper.HtmlEncode(procedure.Status));
        sb.AppendFormat("<div class='field'><span class='field-label'>Prioridad:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Priority));
        sb.AppendFormat("<div class='field'><span class='field-label'>Fecha de ingreso:</span><span class='field-value'>{0}</span></div>", procedure.EntryDate.ToString("dd/MM/yyyy"));
        sb.AppendFormat("<div class='field'><span class='field-label'>Fecha límite:</span><span class='field-value'>{0}</span></div>", procedure.LimitDate.ToString("dd/MM/yyyy"));
        sb.Append("</div>");

        sb.Append("<div class='section'>");
        sb.Append("<div class='section-title'>Solicitante</div>");
        sb.AppendFormat("<div class='field'><span class='field-label'>Identificación:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Applicant.Identification));
        sb.AppendFormat("<div class='field'><span class='field-label'>Nombre:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Applicant.Name));
        sb.AppendFormat("<div class='field'><span class='field-label'>Teléfono:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Applicant.Phone));
        sb.AppendFormat("<div class='field'><span class='field-label'>Correo:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Applicant.Email));
        sb.AppendFormat("<div class='field'><span class='field-label'>Dirección:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Applicant.FiscalAddress));
        sb.Append("</div>");

        sb.Append("<div class='section'>");
        sb.Append("<div class='section-title'>Objeto del Trámite</div>");
        if (!string.IsNullOrWhiteSpace(procedure.Object.Summary))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Resumen:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Object.Summary));
        }
        if (!string.IsNullOrWhiteSpace(procedure.Object.NumeroFinca))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Número de finca:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Object.NumeroFinca));
        }
        if (!string.IsNullOrWhiteSpace(procedure.Object.Distrito))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Distrito:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Object.Distrito));
        }
        if (!string.IsNullOrWhiteSpace(procedure.Object.NombreComercial))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Nombre comercial:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Object.NombreComercial));
        }
        if (!string.IsNullOrWhiteSpace(procedure.Object.PermisoVinculadoExpediente))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Permiso vinculado:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Object.PermisoVinculadoExpediente));
        }
        if (!string.IsNullOrWhiteSpace(procedure.Object.Descripcion))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Descripción:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Object.Descripcion));
        }
        sb.Append("</div>");

        sb.Append("<div class='section'>");
        sb.Append("<div class='section-title'>Gestión</div>");
        sb.AppendFormat("<div class='field'><span class='field-label'>Módulo:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.ResolverModule));
        sb.AppendFormat("<div class='field'><span class='field-label'>Departamento:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Department));
        sb.AppendFormat("<div class='field'><span class='field-label'>Responsable:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Responsible));
        sb.AppendFormat("<div class='field'><span class='field-label'>Equipo:</span><span class='field-value'>{0}</span></div>", DocumentExportHelper.HtmlEncode(procedure.Team));
        sb.Append("</div>");

        if (procedure.Requirements.Any())
        {
            sb.Append("<div class='section'>");
            sb.Append("<div class='section-title'>Requisitos</div>");
            sb.Append("<table>");
            sb.Append("<thead><tr><th>Requisito</th><th>Estado</th><th>Observación</th></tr></thead>");
            sb.Append("<tbody>");
            foreach (var req in procedure.Requirements)
            {
                sb.Append("<tr>");
                sb.AppendFormat("<td>{0}</td>", DocumentExportHelper.HtmlEncode(req.Name));
                sb.AppendFormat("<td><span class='badge badge-{0}'>{1}</span></td>",
                    req.Status == "Recibido" ? "success" : req.Status == "Pendiente" ? "warning" : "info",
                    DocumentExportHelper.HtmlEncode(req.Status));
                sb.AppendFormat("<td>{0}</td>", DocumentExportHelper.HtmlEncode(req.Observation));
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            sb.Append("</div>");
        }

        if (procedure.History.Any())
        {
            sb.Append("<div class='section'>");
            sb.Append("<div class='section-title'>Historial</div>");
            sb.Append("<table>");
            sb.Append("<thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Comentario</th></tr></thead>");
            sb.Append("<tbody>");
            foreach (var evt in procedure.History.OrderByDescending(h => h.Date))
            {
                sb.Append("<tr>");
                sb.AppendFormat("<td>{0}</td>", evt.Date.ToString("dd/MM/yyyy HH:mm"));
                sb.AppendFormat("<td>{0}</td>", DocumentExportHelper.HtmlEncode(evt.User));
                sb.AppendFormat("<td>{0}</td>", DocumentExportHelper.HtmlEncode(evt.Action));
                sb.AppendFormat("<td>{0}</td>", DocumentExportHelper.HtmlEncode(evt.Comment));
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            sb.Append("</div>");
        }

        return DocumentExportHelper.BuildMunicipalDocument("Expediente de Trámite", procedure.CaseNumber, sb.ToString());
    }
}