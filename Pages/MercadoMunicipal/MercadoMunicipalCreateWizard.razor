@page "/mercado-municipal/nuevo"
@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using BlazorApp.Models
@using BlazorApp.Services
@using BlazorApp.Shared
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Mercado Municipal - Nuevo local / contrato</PageTitle>

<WizardShell Title="Nuevo local / contrato / derecho de piso"
             Subtitle="Registro step-by-step para locales fijos, derechos de piso, contratos, cobro mock y validación final."
             ModuleName="Mercado Municipal"
             ProcessCode="MM-8.1C"
             SummaryTitle="Resumen lateral"
             State="@WizardState"
             ProcessSummaryItems="@summaryItems"
             CurrentStepTitle="@currentStepDefinition.Title"
             CurrentStepSubtitle="@currentStepDefinition.Description"
             LastAuditEvent="@lastAuditEvent"
             NextSuggestedStep="@nextSuggestedStep"
             DraftSavedBy="@draftSavedBy"
             DraftMessage="@draftMessage"
             CanGoBack="@(currentStepIndex > 0)"
             CanGoNext="@(currentStepIndex < stepDefinitions.Count - 1)"
             CanFinish="@(currentStepIndex == stepDefinitions.Count - 1 && !blockingValidationResults.Any())"
             ShowValidationSummary="true"
             IsBusy="@isBusy"
             IsNavigating="@isNavigating"
             IsSavingDraft="@isSavingDraft"
             IsCancelling="@isCancelling"
             IsFinishing="@isFinishing"
             SaveDraftMessage="Borrador de Mercado Municipal guardado correctamente."
             CancelDialogTitle="Cancelar gestión de Mercado Municipal"
             CancelDialogMessage="¿Desea cancelar la gestión de Mercado Municipal? Los datos no guardados se perderán."
             CancelWarningMessage="Puede guardar un borrador mock antes de salir si desea conservar el avance visual."
             CancelledMessage="Gestión de Mercado Municipal cancelada."
             OnBack="PreviousStepAsync"
             OnNext="NextStepAsync"
             OnSaveDraft="SaveDraftAsync"
             OnCancel="CancelAsync"
             OnFinish="FinishAsync">
    <ChildContent>
        @switch (currentStepIndex)
        {
        case 0:
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Defina la gestión, el canal de ingreso y el departamento responsable para inicializar el expediente mock.
                </MudAlert>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" Label="Tipo de gestión" @bind-Value="model.ManagementType">
                            @foreach (var option in managementTypes)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" Label="Canal de ingreso" @bind-Value="model.IntakeChannel">
                            @foreach (var option in intakeChannels)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Número de expediente mock" @bind-Value="model.MockFileNumber" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Estado inicial" @bind-Value="model.InitialStatus">
                            @foreach (var option in initialStatuses)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Departamento responsable" @bind-Value="model.ResponsibleDepartment">
                            @foreach (var option in departments)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudStack>
            break;

        case 1:
            <MudStack Spacing="3">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Número de local" @bind-Value="model.LocalNumber" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Número de cuenta" @bind-Value="model.AccountNumber" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Tipo de local" @bind-Value="model.LocalType">
                            @foreach (var option in localTypes)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Periodicidad / tipo de alquiler" @bind-Value="model.RentalType">
                            @foreach (var option in rentalTypes)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Estado" @bind-Value="model.LocalStatus">
                            @foreach (var option in localStatuses)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Piso" @bind-Value="model.Floor" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Zona" @bind-Value="model.Zone" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Sector" @bind-Value="model.Sector" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Pasillo" @bind-Value="model.Aisle" />
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" Label="Localización" @bind-Value="model.Location" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Bien inmueble asociado" @bind-Value="model.RelatedProperty" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Número de patente" @bind-Value="model.PatentNumber" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Cuenta de servicios" @bind-Value="model.ServiceAccount" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Número de medidor eléctrico" @bind-Value="model.ElectricMeterNumber" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="decimal?" Label="Área m2" @bind-Value="model.AreaM2" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="decimal?" Label="Factor ponderación" @bind-Value="model.WeightingFactor" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="decimal?" Label="Precio propuesto" @bind-Value="model.ProposedPrice" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="decimal?" Label="Monto de alquiler" @bind-Value="model.RentAmount" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Actividad comercial permitida" @bind-Value="model.PermittedBusinessActivity" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Nombre comercial" @bind-Value="model.CommercialName" />
                    </MudItem>
                </MudGrid>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2">Fotografía placeholder</MudText>
                            <MudText Typo="Typo.body2">@model.LocalPhotoPlaceholder</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2">Documento placeholder</MudText>
                            <MudText Typo="Typo.body2">@model.LocalDocumentPlaceholder</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudStack>
            break;

        case 2:
            <MudStack Spacing="3">
                @if (model.RucStatus.Equals("Pendiente", StringComparison.OrdinalIgnoreCase))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        El RUC mock del inquilino se encuentra pendiente y requiere validación visual antes de finalizar.
                    </MudAlert>
                }
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Inquilino vinculado a RUC mock" @bind-Value="model.LinkedRuc" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Identificación" @bind-Value="model.Identification" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Nombre o razón social" @bind-Value="model.TenantName" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Tipo de persona" @bind-Value="model.PersonType">
                            @foreach (var option in personTypes)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Teléfono" @bind-Value="model.Phone" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Correo" @bind-Value="model.Email" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Condición" @bind-Value="model.Condition">
                            @foreach (var option in tenantConditions)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Dirección" @bind-Value="model.Address" AutoGrow="true" MaxLines="3" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Estado RUC" @bind-Value="model.RucStatus" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Calidad de datos RUC" @bind-Value="model.DataQualityStatus" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Actividad económica" @bind-Value="model.EconomicActivity" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Nombre comercial" @bind-Value="model.BusinessName" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Representante legal" @bind-Value="model.LegalRepresentative" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2">Fotografía del inquilino placeholder</MudText>
                            <MudText Typo="Typo.body2">@model.TenantPhotoPlaceholder</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchRucAsync">Buscar en RUC</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Visibility" OnClick="ViewRucAsync">Ver RUC</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Verified" OnClick="ValidateTenantAsync">Validar inquilino</MudButton>
                </MudStack>
            </MudStack>
            break;

        case 3:
            <MudStack Spacing="3">
                @if (model.ShowExpirationAlert)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        El contrato presenta alerta mock por vencimiento contractual y debe revisarse antes de finalizar.
                    </MudAlert>
                }
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Número de contrato" @bind-Value="model.ContractNumber" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" Label="Tipo de contrato" @bind-Value="model.ContractType">
                            @foreach (var option in contractTypes)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" Label="Estado" @bind-Value="model.ContractStatus">
                            @foreach (var option in contractStatuses)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Label="Fecha inicio" @bind-Date="model.ContractStartDate" PickerVariant="PickerVariant.Dialog" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Label="Fecha fin" @bind-Date="model.ContractEndDate" PickerVariant="PickerVariant.Dialog" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="int?" Label="Vigencia en meses" @bind-Value="model.ContractDurationMonths" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudCheckBox T="bool" Label="Vigencia quinquenal" @bind-Value="model.IsFiveYearTerm" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudCheckBox T="bool" Label="Alerta vencimiento" @bind-Value="model.ShowExpirationAlert" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Responsable municipal" @bind-Value="model.MunicipalResponsible" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Documento contrato placeholder" @bind-Value="model.ContractDocumentPlaceholder" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Condiciones principales" @bind-Value="model.MainConditions" AutoGrow="true" MaxLines="4" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Obligaciones del arrendatario" @bind-Value="model.TenantObligations" AutoGrow="true" MaxLines="4" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Observaciones" @bind-Value="model.ContractObservations" AutoGrow="true" MaxLines="3" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Firma digital referencial" @bind-Value="model.SignatureReference" />
                    </MudItem>
                </MudGrid>
            </MudStack>
            break;

        case 4:
            <MudStack Spacing="3">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="3">
                        <MudTextField T="decimal?" Label="Monto mensual" @bind-Value="model.MonthlyAmount" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="string" Label="Moneda" @bind-Value="model.Currency" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="Periodicidad" @bind-Value="model.ChargePeriodicity">
                            @foreach (var option in chargePeriodicities)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="int?" Label="Mes inicial" @bind-Value="model.StartMonth" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="int?" Label="Mes final" @bind-Value="model.EndMonth" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="int?" Label="Año inicial" @bind-Value="model.StartYear" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="int?" Label="Año final" @bind-Value="model.EndYear" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudDatePicker Label="Fecha de cobro" @bind-Date="model.ChargeDate" PickerVariant="PickerVariant.Dialog" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudDatePicker Label="Fecha de vencimiento" @bind-Date="model.ChargeDueDate" PickerVariant="PickerVariant.Dialog" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="decimal?" Label="Factor ponderación" @bind-Value="model.ChargeWeightingFactor" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="decimal?" Label="Valor por m2" @bind-Value="model.PricePerM2" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="decimal?" Label="Área m2" @bind-Value="model.ChargeAreaM2" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="decimal?" Label="Monto calculado mock" @bind-Value="model.MockCalculatedAmount" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="decimal?" Label="Depósito o garantía mock" @bind-Value="model.DepositGuarantee" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="decimal?" Label="Descuento" @bind-Value="model.DiscountAmount" />
                    </MudItem>
                    <MudItem xs="12" md="12">
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                            <MudCheckBox T="bool" Label="Ajuste anual" @bind-Value="model.AnnualAdjustment" />
                            <MudCheckBox T="bool" Label="Reajuste individual" @bind-Value="model.IndividualAdjustment" />
                            <MudCheckBox T="bool" Label="Reajuste colectivo" @bind-Value="model.CollectiveAdjustment" />
                            <MudCheckBox T="bool" Label="Suspensión de cobro" @bind-Value="model.ChargeSuspension" />
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" md="12">
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                            <MudCheckBox T="bool" Label="Agua" @bind-Value="model.HasWaterService" />
                            <MudCheckBox T="bool" Label="Electricidad referencial" @bind-Value="model.HasElectricityService" />
                            <MudCheckBox T="bool" Label="Recolección" @bind-Value="model.HasCollectionService" />
                            <MudCheckBox T="bool" Label="Mantenimiento" @bind-Value="model.HasMaintenanceService" />
                            <MudCheckBox T="bool" Label="Otros" @bind-Value="model.HasOtherService" />
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Motivo de descuento" @bind-Value="model.DiscountReason" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Observaciones" @bind-Value="model.ChargeObservations" AutoGrow="true" MaxLines="3" />
                    </MudItem>
                </MudGrid>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Calculate" OnClick="RecalculateAmountAsync">
                    Recalcular monto mock
                </MudButton>
            </MudStack>
            break;

        case 5:
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Esta sección administra requisitos y placeholders documentales sin carga real de archivos.
                </MudAlert>
                @foreach (var requirement in model.Requirements)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle2">@requirement.Name</MudText>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="string" Label="Estado" @bind-Value="requirement.Status">
                                    @foreach (var option in requirementStatuses)
                                    {
                                        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField T="string" Label="Documento placeholder" @bind-Value="requirement.DocumentPlaceholder" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField T="string" Label="Usuario receptor" @bind-Value="requirement.ReceivedBy" />
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudTextField T="string" Label="Observación" @bind-Value="requirement.Observation" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Fecha recepción" @bind-Date="requirement.ReceivedAt" PickerVariant="PickerVariant.Dialog" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            </MudStack>
            break;

        case 6:
            <MudStack Spacing="3">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2">Cuenta local</MudText>
                            <MudText Typo="Typo.body2">@model.LocalAccount</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2">Cuenta tributaria mock</MudText>
                            <MudText Typo="Typo.body2">@model.TaxAccountNumber</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2">Estado</MudText>
                            <MudChip T="string" Text="@model.AccountStatus" Color="@ResolveStatusColor(model.AccountStatus)" Variant="Variant.Outlined" Size="Size.Small" />
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Resumen de cuentas por cobrar" @bind-Value="model.ReceivableChangeSummary" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="decimal?" Label="Saldo" @bind-Value="model.AccountBalance" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Label="Último pago" @bind-Date="model.LastPaymentDate" PickerVariant="PickerVariant.Dialog" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="decimal?" Label="Cuota mensual generada" @bind-Value="model.MonthlyQuotaGenerated" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Emisión mensual mock" @bind-Value="model.MonthlyEmissionMock" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="Emisión anual mock" @bind-Value="model.AnnualEmissionMock" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Cobro administrativo referencial" @bind-Value="model.CollectionReferenceStatus" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Tesorería/Cajas/Conectividad referencial" @bind-Value="model.TreasuryReferenceStatus" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="GenerateMonthlyQuotaAsync">Generar cuota mensual mock</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Payments" OnClick="SimulateMonthlyEmissionAsync">Simular emisión mensual</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.AttachMoney" OnClick="SimulatePaymentAsync">Simular pago</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Gavel" OnClick="SendToCollectionAsync">Enviar a cobro administrativo mock</MudButton>
                </MudStack>

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="7">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Cuentas por cobrar relacionadas</MudText>
                            @foreach (var receivable in receivablePreview)
                            {
                                <MudPaper Outlined="true" Class="pa-2 mb-2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudText Typo="Typo.body2">@($"{receivable.EmissionNumber} · {receivable.TaxpayerName}")</MudText>
                                        <MudChip T="string" Text="@receivable.Status" Color="@ResolveStatusColor(receivable.Status)" Variant="Variant.Outlined" Size="Size.Small" />
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Integraciones mock</MudText>
                            @foreach (var integration in integrationPreview)
                            {
                                <MudChip T="string" Text="@($"{integration.Name}: {integration.Status}")" Color="@ResolveStatusColor(integration.Status)" Variant="Variant.Outlined" Size="Size.Small" Class="me-1 mb-1" />
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudStack>
            break;

        case 7:
            <MudStack Spacing="3">
                @if (blockingValidationResults.Any())
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        Aún existen validaciones pendientes antes de finalizar la gestión.
                    </MudAlert>
                }

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Class="mb-2">Resumen de gestión</MudText>
