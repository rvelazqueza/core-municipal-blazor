    private Task ValidateTenantAsync()
    {
        model.DataQualityStatus = "Validada";
        if (model.RucStatus.Equals("Pendiente", StringComparison.OrdinalIgnoreCase))
        {
            model.RucStatus = "Activo";
        }

        Snackbar.Add("Inquilino validado en modo mock.", Severity.Success);
        return Task.CompletedTask;
    }

    private Task RecalculateAmountAsync()
    {
        var area = model.ChargeAreaM2 ?? model.AreaM2 ?? 0m;
        var factor = model.ChargeWeightingFactor ?? model.WeightingFactor ?? 1m;
        var price = model.PricePerM2 ?? model.ProposedPrice ?? 0m;
        model.MockCalculatedAmount = Math.Round(area * factor * price, 2);
        Snackbar.Add("Monto recalculado de forma visual.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task GenerateMonthlyQuotaAsync()
    {
        model.MonthlyQuotaGenerated = model.MonthlyAmount ?? model.MockCalculatedAmount ?? model.RentAmount ?? 0m;
        model.AccountStatus = "Preparado";
        Snackbar.Add("Cuota mensual mock generada.", Severity.Success);
        return Task.CompletedTask;
    }

    private Task SimulateMonthlyEmissionAsync()
    {
        model.MonthlyEmissionMock = $"EMI-MEN-{DateTime.Now:yyyyMMdd-HHmm}";
        model.CollectionReferenceStatus = "Simulado";
        Snackbar.Add("Emisión mensual mock simulada.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task SimulatePaymentAsync()
    {
        model.LastPaymentDate = DateTime.Today;
        model.AccountBalance = Math.Max(0m, (model.AccountBalance ?? 0m) - (model.MonthlyQuotaGenerated ?? 0m));
        model.AccountStatus = model.AccountBalance > 0 ? "Activo" : "Al día";
        Snackbar.Add("Pago mock aplicado correctamente.", Severity.Success);
        return Task.CompletedTask;
    }

    private Task SendToCollectionAsync()
    {
        model.AccountStatus = "En cobro administrativo";
        model.CollectionReferenceStatus = "En cobro administrativo";
        Snackbar.Add("Cuenta enviada a cobro administrativo mock.", Severity.Warning);
        return Task.CompletedTask;
    }

    private static string ResolveSeverity(string value)
    {
        return string.IsNullOrWhiteSpace(value) || value.Equals("Pendiente", StringComparison.OrdinalIgnoreCase)
            ? "Warning"
            : "Success";
    }

    private static Color ResolveStatusColor(string status)
    {
        if (status.Equals("Error", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Moroso", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Vencido", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Cancelado", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Rescindido", StringComparison.OrdinalIgnoreCase))
            return Color.Error;

        if (status.Equals("Warning", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Pendiente", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Próximo a vencer", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Suspendido", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("En remate", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("En cobro administrativo", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Sin guardar", StringComparison.OrdinalIgnoreCase))
            return Color.Warning;

        if (status.Equals("Simulado", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Referencial", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Preparado", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Borrador", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Borrador guardado", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("En progreso", StringComparison.OrdinalIgnoreCase))
            return Color.Info;

        if (status.Equals("Activo", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Al día", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Alquilado", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Presentado", StringComparison.OrdinalIgnoreCase) ||
            status.Equals("Success", StringComparison.OrdinalIgnoreCase))
            return Color.Success;

        return Color.Default;
    }

    private static string FormatCurrency(decimal? value)
    {
        return value.HasValue ? $"CRC {value.Value.ToString("N2", CultureInfo.InvariantCulture)}" : "Pendiente";
    }
