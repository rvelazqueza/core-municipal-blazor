        Snackbar.Add("Búsqueda RUC mock ejecutada sin integración real.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task ViewRucAsync()
    {
        Snackbar.Add("Vista RUC referencial disponible solo en modo demo.", Severity.Info);
