                                <MudText>Expediente mock: @model.MockFileNumber</MudText>
                                <MudText>Departamento: @model.ResponsibleDepartment</MudText>
                                <MudText>Canal: @model.IntakeChannel</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Class="mb-2">Local o derecho de piso</MudText>
                                <MudText>Local: @model.LocalNumber</MudText>
                                <MudText>Cuenta: @model.AccountNumber</MudText>
                                <MudText>Estado: @model.LocalStatus</MudText>
                                <MudText>Monto alquiler: @FormatCurrency(model.RentAmount)</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Class="mb-2">Inquilino</MudText>
                                <MudText>Nombre: @model.TenantName</MudText>
                                <MudText>Identificación: @model.Identification</MudText>
                                <MudText>Condición: @model.Condition</MudText>
                                <MudText>RUC: @model.RucStatus</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Class="mb-2">Contrato y cobro</MudText>
                                <MudText>Contrato: @model.ContractNumber</MudText>
                                <MudText>Estado: @model.ContractStatus</MudText>
                                <MudText>Periodicidad: @model.ChargePeriodicity</MudText>
                                <MudText>Cuenta tributaria: @model.TaxAccountNumber</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Validaciones pendientes</MudText>
                    @if (allValidationResults.Any())
                    {
                        @foreach (var item in allValidationResults)
                        {
                            <MudPaper Outlined="true" Class="pa-2 mb-2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.body2">@($"Paso {item.StepIndex + 1} - {item.Message}")</MudText>
                                    <MudChip T="string" Text="@item.Severity" Color="@ResolveStatusColor(item.Severity)" Variant="Variant.Outlined" Size="Size.Small" />
                                </MudStack>
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                            El expediente demo está listo para finalizar.
                        </MudAlert>
                    }
                </MudPaper>
            </MudStack>
            break;
        }
    </ChildContent>

    <SummaryContent>
        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">Indicadores rápidos</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
