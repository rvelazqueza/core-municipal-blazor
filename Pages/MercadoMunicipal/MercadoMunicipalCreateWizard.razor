                    <MudChip T="string" Text="@($"Contrato: {model.ContractStatus}")" Color="@ResolveStatusColor(model.ContractStatus)" Variant="Variant.Outlined" Size="Size.Small" />
                    <MudChip T="string" Text="@($"Cuenta: {model.AccountStatus}")" Color="@ResolveStatusColor(model.AccountStatus)" Variant="Variant.Outlined" Size="Size.Small" />
                    <MudChip T="string" Text="@($"Borrador: {draftStatusLabel}")" Color="@ResolveStatusColor(draftStatusLabel)" Variant="Variant.Outlined" Size="Size.Small" />
                </MudStack>
                <MudText Typo="Typo.caption">Último guardado mock: @lastSavedLabel</MudText>
            </MudStack>
        </MudPaper>
    </SummaryContent>
</WizardShell>

