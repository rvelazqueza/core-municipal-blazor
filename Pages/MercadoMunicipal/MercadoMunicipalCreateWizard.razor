    private List<MmWizardRequirementItemViewModel> BuildRequirementViewModels()
    {
        var checklist = new[]
        {
            "Identificación del inquilino",
            "Personería jurídica, si aplica",
            "Contrato firmado",
            "Documento de adjudicación",
            "Acuerdo de Concejo Municipal, si aplica",
            "Autorización de traspaso, si aplica",
            "Comprobante de garantía",
            "Patente o actividad comercial, referencial",
            "Permiso sanitario, si aplica",
            "Constancia de estar al día, mock",
            "Fotografía del local",
            "Fotografía del inquilino",
            "Documentación de derecho de piso",
            "Documento de remodelación, si aplica",
            "Otros requisitos"
        };

        return checklist.Select((name, index) =>
        {
            var match = requirements.FirstOrDefault(item => item.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
            return new MmWizardRequirementItemViewModel
            {
                Name = name,
                Status = match?.Status ?? (index < 4 ? "Presentado" : "Pendiente"),
                DocumentPlaceholder = match?.DocumentPlaceholder ?? $"Documento placeholder {index + 1:00}",
                Observation = match?.Observation ?? "Revisión documental mock.",
                ReceivedBy = match?.ReceivedBy ?? "Ventanilla Mercado",
                ReceivedAt = match?.ReceivedAt ?? DateTime.Today.AddDays(-(index + 1))
            };
        }).ToList();
    }

    private WizardStateDto BuildWizardState()
    {
        var validations = BuildValidationResults();
        var steps = new List<WizardStepDto>();

        foreach (var entry in stepDefinitions.Select((value, index) => new { value, index }))
        {
            var stepValidations = validations.Where(item => item.StepIndex == entry.index).ToList();
            var hasErrors = stepValidations.Any(item => !item.IsValid);
            var hasWarnings = stepValidations.Any(item => item.HasWarnings);

            steps.Add(new WizardStepDto
            {
                Id = entry.value.Id,
                Index = entry.index,
                Order = entry.index + 1,
                Title = entry.value.Title,
                Description = entry.value.Description,
                Subtitle = entry.value.Description,
                Icon = entry.value.Icon,
                IsActive = entry.index == currentStepIndex,
                IsCompleted = entry.index < currentStepIndex && !hasErrors,
                HasErrors = hasErrors,
                HasWarnings = hasWarnings,
                Status = hasErrors ? "Con errores" : hasWarnings ? "Con alertas" : entry.index < currentStepIndex ? "Completado" : entry.index == currentStepIndex ? "En progreso" : "Pendiente",
                ValidationMessages = stepValidations.Select(item => item.Message).ToList(),
                Validations = stepValidations
            });
        }

        var progress = Math.Round(((currentStepIndex + 1d) / stepDefinitions.Count) * 100d, 0);

        return new WizardStateDto
        {
            ProcessId = model.MockFileNumber,
            ProcessKey = model.MockFileNumber,
            ProcessCode = "MM-8.1C",
            ModuleName = "Mercado Municipal",
            ProcessName = model.ManagementType,
            ProcessTitle = "Nuevo local / contrato / derecho de piso",
            CurrentStepId = currentStepDefinition.Id,
            CurrentStepIndex = currentStepIndex,
            TotalSteps = stepDefinitions.Count,
            ProgressPercent = progress,
            ProgressPercentage = (decimal)progress,
            Status = isFinished ? "Completado" : draftSavedAt.HasValue ? "Borrador" : "En progreso",
            StartedAt = startedAt,
            UpdatedAt = DateTime.Now,
            FinishedAt = isFinished ? DateTime.Now : null,
            LastSavedAt = draftSavedAt,
            CreatedBy = draftSavedBy,
            IsDirty = !draftSavedAt.HasValue,
            DraftState = new DraftStateDto
            {
                DraftId = $"DRF-{model.MockFileNumber}",
                ProcessId = model.MockFileNumber,
                ModuleName = "Mercado Municipal",
                ProcessName = model.ManagementType,
                Status = draftStatusLabel,
                LastSavedAt = draftSavedAt,
                SavedBy = draftSavedBy,
                HasUnsavedChanges = !draftSavedAt.HasValue,
                Message = draftMessage
            },
            Steps = steps,
            ValidationResults = validations,
            PendingValidations = validations.Where(item => !item.IsValid).Select(item => item.Message).Distinct().ToList(),
            ProcessSummaryItems = summaryItems
        };
    }

    private List<ProcessSummaryItemDto> BuildProcessSummaryItems()
    {
        return new List<ProcessSummaryItemDto>
        {
            new() { Group = "Gestión", Label = "Tipo", Value = string.IsNullOrWhiteSpace(model.ManagementType) ? "Pendiente" : model.ManagementType, Icon = Icons.Material.Filled.AccountTree, Severity = ResolveSeverity(model.ManagementType) },
            new() { Group = "Gestión", Label = "Canal", Value = string.IsNullOrWhiteSpace(model.IntakeChannel) ? "Pendiente" : model.IntakeChannel, Icon = Icons.Material.Filled.Store, Severity = ResolveSeverity(model.IntakeChannel) },
            new() { Group = "Local", Label = "Local", Value = string.IsNullOrWhiteSpace(model.LocalNumber) ? "Pendiente" : model.LocalNumber, Icon = Icons.Material.Filled.Storefront, Severity = ResolveSeverity(model.LocalNumber) },
            new() { Group = "Local", Label = "Estado", Value = string.IsNullOrWhiteSpace(model.LocalStatus) ? "Pendiente" : model.LocalStatus, Icon = Icons.Material.Filled.Circle, Severity = ResolveSeverity(model.LocalStatus) },
            new() { Group = "Inquilino", Label = "Inquilino", Value = string.IsNullOrWhiteSpace(model.TenantName) ? "Pendiente" : model.TenantName, Icon = Icons.Material.Filled.Person, Severity = ResolveSeverity(model.TenantName) },
            new() { Group = "Contrato", Label = "Contrato", Value = string.IsNullOrWhiteSpace(model.ContractNumber) ? "Pendiente" : model.ContractNumber, Icon = Icons.Material.Filled.Description, Severity = ResolveSeverity(model.ContractNumber) },
            new() { Group = "Cobro", Label = "Monto", Value = FormatCurrency(model.MonthlyAmount), Icon = Icons.Material.Filled.RequestQuote, Severity = model.MonthlyAmount.HasValue ? "Success" : "Warning" },
            new() { Group = "Cuenta", Label = "Estado cuenta", Value = string.IsNullOrWhiteSpace(model.AccountStatus) ? "Pendiente" : model.AccountStatus, Icon = Icons.Material.Filled.ReceiptLong, Severity = ResolveSeverity(model.AccountStatus) }
        };
    }

    private List<StepValidationResultDto> BuildValidationResults()
    {
        var results = new List<StepValidationResultDto>();

        AddError(0, "Tipo de gestión obligatorio.", string.IsNullOrWhiteSpace(model.ManagementType));
        AddError(0, "Canal obligatorio.", string.IsNullOrWhiteSpace(model.IntakeChannel));
        AddError(0, "Departamento responsable obligatorio.", string.IsNullOrWhiteSpace(model.ResponsibleDepartment));

        AddError(1, "Número de local requerido.", string.IsNullOrWhiteSpace(model.LocalNumber));
        AddError(1, "Tipo de local requerido.", string.IsNullOrWhiteSpace(model.LocalType));
        AddError(1, "Estado requerido.", string.IsNullOrWhiteSpace(model.LocalStatus));
        AddError(1, "Área requerida.", !model.AreaM2.HasValue || model.AreaM2 <= 0);
        AddWarning(1, "Monto de alquiler recomendado.", !model.RentAmount.HasValue || model.RentAmount <= 0);

        AddError(2, "Identificación requerida.", string.IsNullOrWhiteSpace(model.Identification));
        AddError(2, "Nombre requerido.", string.IsNullOrWhiteSpace(model.TenantName));
        AddWarning(2, "Medio de notificación recomendado.", string.IsNullOrWhiteSpace(model.Phone) && string.IsNullOrWhiteSpace(model.Email));
        AddWarning(2, "Si RUC está pendiente, mostrar advertencia.", model.RucStatus.Equals("Pendiente", StringComparison.OrdinalIgnoreCase));

        AddWarning(3, "Número de contrato recomendado.", string.IsNullOrWhiteSpace(model.ContractNumber));
        AddError(3, "Fecha inicio requerida.", !model.ContractStartDate.HasValue);
        AddError(3, "Fecha fin debe ser mayor o igual a fecha inicio.", model.ContractStartDate.HasValue && model.ContractEndDate.HasValue && model.ContractEndDate < model.ContractStartDate);
        AddError(3, "Estado requerido.", string.IsNullOrWhiteSpace(model.ContractStatus));

        AddError(4, "Monto mensual requerido.", !model.MonthlyAmount.HasValue || model.MonthlyAmount <= 0);
        AddError(4, "Área requerida.", !model.ChargeAreaM2.HasValue || model.ChargeAreaM2 <= 0);
        AddError(4, "Si hay suspensión de cobro, solicitar observación.", model.ChargeSuspension && string.IsNullOrWhiteSpace(model.ChargeObservations));
        AddError(4, "Si hay descuento, solicitar motivo.", model.DiscountAmount.HasValue && model.DiscountAmount > 0 && string.IsNullOrWhiteSpace(model.DiscountReason));

        AddWarning(5, "Debe existir al menos un requisito presentado.", !model.Requirements.Any(item => item.Status == "Presentado"));
        AddWarning(5, "Hay requisitos observados en revisión mock.", model.Requirements.Any(item => item.Status == "Observado"));

        AddWarning(6, "Cuenta tributaria mock recomendada.", string.IsNullOrWhiteSpace(model.TaxAccountNumber));
        AddWarning(6, "Emisión mensual mock recomendada.", string.IsNullOrWhiteSpace(model.MonthlyEmissionMock));
        AddWarning(6, "Estado de cuenta con alerta de morosidad.", model.AccountStatus.Equals("Moroso", StringComparison.OrdinalIgnoreCase) || model.AccountStatus.Equals("En cobro administrativo", StringComparison.OrdinalIgnoreCase));

        return results;

        void AddError(int stepIndex, string message, bool condition)
        {
            if (!condition)
                return;

            results.Add(new StepValidationResultDto
            {
                StepId = stepDefinitions[stepIndex].Id,
                StepIndex = stepIndex,
                StepTitle = stepDefinitions[stepIndex].Title,
                Message = message,
                Severity = "Error",
                IsValid = false,
                Code = $"MM-VAL-{stepIndex + 1:00}"
            });
        }

        void AddWarning(int stepIndex, string message, bool condition)
        {
            if (!condition)
                return;

            results.Add(new StepValidationResultDto
            {
                StepId = stepDefinitions[stepIndex].Id,
                StepIndex = stepIndex,
                StepTitle = stepDefinitions[stepIndex].Title,
                Message = message,
                Severity = "Warning",
                IsValid = true,
                HasWarnings = true,
                Code = $"MM-WAR-{stepIndex + 1:00}"
            });
        }
    }

    private async Task PreviousStepAsync()
    {
        isNavigating = true;
        if (currentStepIndex > 0)
        {
            currentStepIndex--;
        }

        await Task.Delay(50);
        isNavigating = false;
    }

    private async Task NextStepAsync()
    {
        isNavigating = true;
        var currentErrors = BuildValidationResults().Where(item => item.StepIndex == currentStepIndex && !item.IsValid).ToList();

        if (currentErrors.Any())
        {
            Snackbar.Add(currentErrors.First().Message, Severity.Warning);
            isNavigating = false;
            return;
        }

        if (currentStepIndex < stepDefinitions.Count - 1)
        {
            currentStepIndex++;
        }

        await Task.Delay(50);
        isNavigating = false;
    }

    private async Task SaveDraftAsync()
    {
        isSavingDraft = true;
        await Task.Delay(100);
        draftSavedAt = DateTime.Now;
        draftMessage = $"Borrador guardado el {draftSavedAt:dd/MM/yyyy HH:mm}.";
        model.InitialStatus = "Borrador";
        lastAuditEvent = $"Evento mock: borrador guardado por {draftSavedBy} el {draftSavedAt:dd/MM/yyyy HH:mm}.";
        isSavingDraft = false;
    }

    private Task CancelAsync()
    {
        isCancelling = true;
        Navigation.NavigateTo("/mercado-municipal");
        return Task.CompletedTask;
    }

    private async Task FinishAsync()
    {
        isFinishing = true;
        var errors = BuildValidationResults().Where(item => !item.IsValid).ToList();

        if (errors.Any())
        {
            currentStepIndex = errors.Min(item => item.StepIndex);
            Snackbar.Add("Complete las validaciones obligatorias antes de finalizar.", Severity.Warning);
            isFinishing = false;
            return;
        }

        await Task.Delay(150);
        isFinished = true;
        draftSavedAt ??= DateTime.Now;
        lastAuditEvent = $"Evento mock AUD-MM-{DateTime.Now:HHmmss} generado para {model.MockFileNumber}.";
        Snackbar.Add("Gestión de Mercado Municipal registrada en modo demo.", Severity.Success);
        isFinishing = false;

        if (!string.IsNullOrWhiteSpace(model.SelectedReferenceLocalId) && !model.ManagementType.Equals("Nuevo local", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"/mercado-municipal/expediente/{model.SelectedReferenceLocalId}");
            return;
        }

        Navigation.NavigateTo("/mercado-municipal");
    }

