                    <MudText Typo="Typo.body2">Trámite: @draft.TypeName</MudText>
                    <MudText Typo="Typo.body2">Solicitante: @draft.Applicant.Name</MudText>
                    <MudText Typo="Typo.body2">Propietario: @draft.Owner.Name</MudText>
                    <MudText Typo="Typo.body2">Finca: @draft.Property.PropertyNumber</MudText>
