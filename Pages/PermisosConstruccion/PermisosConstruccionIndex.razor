@page "/permisos-construccion"
@using System.Linq
@using BlazorApp.Models.PermisosConstruccion
@using BlazorApp.Services.PermisosConstruccion
@using BlazorApp.Shared
@using BlazorApp.Helpers
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitleBar Title="Permisos de Construcción" Subtitle="Gestión integral de expedientes de urbanismo, licencias constructivas, revisión técnica, cobros, inspecciones e integraciones municipales." />

<MudStack Spacing="4">
    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <div>
                <MudText Typo="Typo.h4">Permisos de Construcción</MudText>
                <MudText Typo="Typo.body1" Class="text-muted">Gestión integral de expedientes de urbanismo, licencias constructivas, revisión técnica, cobros, inspecciones e integraciones municipales.</MudText>
            </div>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToNewPermit">Nuevo permiso de construcción</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ShowApcSimulatedAsync">Expedientes APC</MudButton>
            </MudStack>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="mt-3 flex-wrap">
            <MudButton Variant="Variant.Outlined" OnClick="ShowObraMenorAsync">Obra menor</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ShowPendingReviewAsync">Pendientes de revisión</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ShowPendingInspectionAsync">Pendientes de inspección</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ShowPendingPaymentAsync">Pendientes de pago</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ShowAnnulmentAsync">Anulaciones</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ShowCorrespondenceAsync">Correspondencia</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ShowReportsAsync">Reportes</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ShowIntegrationsAsync">Integraciones</MudButton>
        </MudStack>
    </MudPaper>

    <PcDashboardPanel Permits="@permits" />

    <PcPermitTable Permits="@permits"
                   OnOpenExpediente="OpenExpedienteAsync"
                   OnEdit="EditPermitAsync"
                   OnReview="ReviewPermitAsync"
                   OnPrevention="PreventPermitAsync"
                   OnAssess="AssessPermitAsync"
                   OnSimulatePayment="SimulatePaymentAsync"
                   OnApprove="ApprovePermitAsync"
                   OnAnnul="AnnulPermitAsync"
                   OnRequestInspection="RequestInspectionAsync"
                   OnAudit="AuditPermitAsync" />

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Integraciones institucionales</MudText>
            <MudGrid Spacing="2">
                @foreach (var integration in integrations.Take(6))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle2">@integration.Name</MudText>
                                <MudChip T="string" Text="@integration.Status" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Class="mt-2">@integration.Description</MudText>
                                <MudText Typo="Typo.caption">Último evento: @integration.LastEvent</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    [Inject] private LocalStorageHelper? LocalStorage { get; set; }
    private readonly PermisosConstruccionMockService service = new();
    private List<PcPermitDto> permits = [];
    private List<PcPermitDto> allPermits = [];
    private List<PcIntegrationStatusDto> integrations = [];
    private string currentView = "Todos";

    protected override async Task OnInitializedAsync()
    {
        var serviceWithStorage = LocalStorage != null ? new PermisosConstruccionMockService(LocalStorage) : service;
        allPermits = await serviceWithStorage.GetPermitsAsync();
        permits = allPermits;
        integrations = await serviceWithStorage.GetIntegrationsAsync();
    }

    private void GoToNewPermit() => Navigation.NavigateTo("/permisos-construccion/nuevo");

    private Task ShowSnackAsync(string message)
    {
        Snackbar.Add(message, Severity.Info);
        return Task.CompletedTask;
    }

    private Task OpenExpedienteAsync(PcPermitDto permit)
    {
        Navigation.NavigateTo($"/permisos-construccion/expediente/{permit.Id}");
        return Task.CompletedTask;
    }

    private Task EditPermitAsync(PcPermitDto permit) => ShowSnackAsync($"Editar {permit.CaseNumber} estará disponible en la siguiente parte.");

    private async Task ReviewPermitAsync(PcPermitDto permit)
    {
        // For now, simplified version without dialog - just mark as reviewed
        if (LocalStorage != null)
        {
            var serviceWithStorage = new PermisosConstruccionMockService(LocalStorage);
            await serviceWithStorage.CompleteReviewAsync(permit.Id, "Técnico municipal", "Revisión completada desde bandeja", "Revisado");
            allPermits = await serviceWithStorage.GetPermitsAsync();
            ApplyCurrentFilter();
            Snackbar.Add($"Revisión completada para {permit.CaseNumber}.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Revisión para {permit.CaseNumber}.", Severity.Info);
        }
    }

    private Task PreventPermitAsync(PcPermitDto permit) => ShowSnackAsync($"Prevención para {permit.CaseNumber}.");
    private Task AssessPermitAsync(PcPermitDto permit) => ShowSnackAsync($"Tasación para {permit.CaseNumber}.");
    private Task SimulatePaymentAsync(PcPermitDto permit) => ShowSnackAsync($"Pago para {permit.CaseNumber}.");
    private Task ApprovePermitAsync(PcPermitDto permit) => ShowSnackAsync($"Aprobación para {permit.CaseNumber}.");
    private Task AnnulPermitAsync(PcPermitDto permit) => ShowSnackAsync($"Anulación para {permit.CaseNumber}.");

    private async Task RequestInspectionAsync(PcPermitDto permit)
    {
        // Simplified version - register inspection directly
        if (LocalStorage != null)
        {
            var serviceWithStorage = new PermisosConstruccionMockService(LocalStorage);
            await serviceWithStorage.RegisterInspectionAsync(permit.Id, DateTime.Today, "Inspector municipal", "Conforme", "Inspección registrada desde bandeja");
            allPermits = await serviceWithStorage.GetPermitsAsync();
            ApplyCurrentFilter();
            Snackbar.Add($"Inspección registrada para {permit.CaseNumber}.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Inspección solicitada para {permit.CaseNumber}.", Severity.Info);
        }
    }

    private Task AuditPermitAsync(PcPermitDto permit) => ShowSnackAsync($"Auditoría para {permit.CaseNumber}.");

    private Task ShowApcSimulatedAsync() => ShowSnackAsync("Expedientes APC disponibles en esta bandeja.");

    private Task ShowObraMenorAsync()
    {
        currentView = "Obra menor";
        permits = allPermits.Where(p => p.TypeCode == "OM" || p.TypeName.Contains("Obra menor", StringComparison.OrdinalIgnoreCase)).ToList();
        Snackbar.Add($"Mostrando {permits.Count} permisos de obra menor.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task ShowPendingReviewAsync()
    {
        currentView = "Pendientes de revisión";
        permits = allPermits.Where(p =>
            p.PermitStatus.Contains("revisión", StringComparison.OrdinalIgnoreCase) ||
            p.PermitStatus.Contains("recibido", StringComparison.OrdinalIgnoreCase) ||
            p.MunicipalReview.Status.Contains("Pendiente", StringComparison.OrdinalIgnoreCase)
        ).ToList();
        Snackbar.Add($"Mostrando {permits.Count} permisos pendientes de revisión.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task ShowPendingInspectionAsync()
    {
        currentView = "Pendientes de inspección";
        permits = allPermits.Where(p =>
            p.PermitStatus.Contains("inspección", StringComparison.OrdinalIgnoreCase) ||
            p.InspectionStatus.Contains("Pendiente", StringComparison.OrdinalIgnoreCase) ||
            p.QualityControl.RequiresInspection && p.QualityControl.InspectionStatus.Contains("Pendiente", StringComparison.OrdinalIgnoreCase)
        ).ToList();
        Snackbar.Add($"Mostrando {permits.Count} permisos pendientes de inspección.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task ShowPendingPaymentAsync() => ShowSnackAsync("Pendientes de pago y cobro.");
    private Task ShowAnnulmentAsync() => ShowSnackAsync("Anulaciones y trazabilidad operativa.");
    private Task ShowCorrespondenceAsync() => ShowSnackAsync("Correspondencia disponible.");
    private Task ShowReportsAsync() => ShowSnackAsync("Reportes operativos disponibles.");
    private Task ShowIntegrationsAsync() => ShowSnackAsync("Integraciones institucionales preparadas.");

    private void ApplyCurrentFilter()
    {
        switch (currentView)
        {
            case "Obra menor":
                ShowObraMenorAsync();
                break;
            case "Pendientes de revisión":
                ShowPendingReviewAsync();
                break;
            case "Pendientes de inspección":
                ShowPendingInspectionAsync();
                break;
            default:
                permits = allPermits;
                break;
        }
    }
}
