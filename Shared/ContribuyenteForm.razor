@using System.ComponentModel.DataAnnotations
@using BlazorApp.Models
@using BlazorApp.Services
@using BlazorApp.Helpers
@using MudBlazor
@inject IMaestroDatosService MaestroDatosService
@inject IContribuyentesService ContribuyentesService
@inject IAuditoriaService AuditoriaService
@inject ISnackbar Snackbar
@inject DocumentExportHelper DocumentExportHelper

<MudPaper Class="pa-4">
    <ValidationSummaryPanel Errors="validationErrors" />

    <MudTabs Outlined="true">
        <MudTabPanel Text="Datos generales" Icon="@Icons.Material.Filled.Badge">
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="Model.TipoPersona" Label="Tipo de persona" Variant="Variant.Outlined">
                        @foreach (var item in tiposPersona)
                        {
                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="Model.TipoIdentificacion" Label="Tipo de identificación" Variant="Variant.Outlined">
                        @foreach (var item in tiposIdentificacion)
                        {
                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="Model.NumeroIdentificacion" Label="Número de identificación" Variant="Variant.Outlined" Required="true" RequiredError="La identificación es obligatoria" />
                </MudItem>
                @if (Model.TipoPersona == "Fisica")
                {
                    <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="Model.Nombre" Label="Nombre" Variant="Variant.Outlined" Required="true" RequiredError="El nombre es obligatorio" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="Model.Apellidos" Label="Apellidos" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="Model.EstadoCivil" Label="Estado civil" Variant="Variant.Outlined">
                            @foreach (var item in estadosCiviles)
                            {
                                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="8"><MudTextField T="string" @bind-Value="Model.RazonSocial" Label="Razón social" Variant="Variant.Outlined" Required="true" RequiredError="La razón social es obligatoria" /></MudItem>
                }
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string" @bind-Value="Model.Nacionalidad" Label="Nacionalidad" Variant="Variant.Outlined" SearchFunc="SearchNacionalidadAsync" Clearable="true" CoerceValue="true" Placeholder="Costarricense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="Model.Telefono" @bind-Value:after="FormatearTelefono" Label="Teléfono" Variant="Variant.Outlined" Placeholder="8888-8888" Validation="@(new Func<string, string?>(ValidarTelefono))" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="Model.Correo" Label="Correo" Variant="Variant.Outlined" Placeholder="correo@dominio.com" Validation="@(new Func<string, string?>(ValidarCorreo))" Immediate="true" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="Model.EstadoContribuyente" Label="Estado del contribuyente" Variant="Variant.Outlined">
                        @foreach (var item in estadosContribuyente)
                        {
                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Dirección fiscal" Icon="@Icons.Material.Filled.LocationOn">
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="Model.DireccionFiscal.Provincia" Label="Provincia" Variant="Variant.Outlined">
                        @foreach (var item in provincias)
                        {
                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="Model.DireccionFiscal.Canton" Label="Cantón" Variant="Variant.Outlined">
                        @foreach (var item in cantones)
                        {
                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="Model.DireccionFiscal.Distrito" Label="Distrito" Variant="Variant.Outlined">
                        @foreach (var item in distritos)
                        {
                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="Model.DireccionFiscal.DireccionExacta" Label="Dirección exacta" Variant="Variant.Outlined" Lines="3" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Representante y actividad" Icon="@Icons.Material.Filled.BusinessCenter">
            <MudGrid Class="mt-2">
                @if (Model.TipoPersona == "Juridica")
                {
                    <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="Model.RepresentanteLegal.NombreCompleto" Label="Representante legal" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="Model.RepresentanteLegal.Identificacion" Label="Identificación representante" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="Model.RepresentanteLegal.Telefono" @bind-Value:after="FormatearTelefonoRepresentante" Label="Teléfono representante" Variant="Variant.Outlined" Placeholder="8888-8888" Validation="@(new Func<string, string?>(ValidarTelefono))" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="Model.RepresentanteLegal.Correo" Label="Correo representante" Variant="Variant.Outlined" Placeholder="correo@dominio.com" Validation="@(new Func<string, string?>(ValidarCorreo))" Immediate="true" InputType="InputType.Email" />
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="Model.ActividadEconomica" Label="Actividad económica" Variant="Variant.Outlined">
                        @foreach (var item in actividades)
                        {
                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex align-center">
                    <MudBadge Dot="@Model.IndicadorDifunto" Color="Color.Error" Class="me-3">
                        <MudText Typo="Typo.body1">Indicador TSE / difunto</MudText>
                    </MudBadge>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Vínculos" Icon="@Icons.Material.Filled.Link">
            <MudGrid Class="mt-2">
                <MudItem xs="12" lg="6">
                    <MudPaper Outlined="true" Class="pa-3 h-100">
                        <MudText Typo="Typo.subtitle1" GutterBottom="true">Tributos vinculados</MudText>
                        @if (Model.TributosVinculados.Any())
                        {
                            <MudTable Items="Model.TributosVinculados" Hover="true" Breakpoint="Breakpoint.None">
                                <HeaderContent><MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh>Estado</MudTh></HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Código">@context.Codigo</MudTd>
                                    <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                                    <MudTd DataLabel="Estado"><StatusBadge Text="@context.Estado" /></MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Sin tributos vinculados.</MudText>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="6">
                    <MudPaper Outlined="true" Class="pa-3 h-100">
                        <MudText Typo="Typo.subtitle1" GutterBottom="true">Bienes inmuebles vinculados</MudText>
                        @if (Model.BienesInmueblesVinculados.Any())
                        {
                            <MudTable Items="Model.BienesInmueblesVinculados" Hover="true" Breakpoint="Breakpoint.None">
                                <HeaderContent><MudTh>Finca</MudTh><MudTh>Distrito</MudTh><MudTh>Uso</MudTh><MudTh>Estado</MudTh></HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Finca">@context.FincaNumero</MudTd>
                                    <MudTd DataLabel="Distrito">@context.Distrito</MudTd>
                                    <MudTd DataLabel="Uso">@context.Uso</MudTd>
                                    <MudTd DataLabel="Estado"><StatusBadge Text="@context.Estado" /></MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Sin bienes inmuebles vinculados.</MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Historial" Icon="@Icons.Material.Filled.History">
            <MudTable Items="Historial" Hover="true" Breakpoint="Breakpoint.Sm" Class="mt-2">
                <HeaderContent>
                    <MudTh>Usuario</MudTh>
                    <MudTh>Fecha y hora</MudTh>
                    <MudTh>Campo</MudTh>
                    <MudTh>Anterior</MudTh>
                    <MudTh>Nuevo</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Usuario">@context.Usuario</MudTd>
                    <MudTd DataLabel="Fecha y hora">@context.FechaHora.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Campo">@context.CampoModificado</MudTd>
                    <MudTd DataLabel="Anterior">@context.ValorAnterior</MudTd>
                    <MudTd DataLabel="Nuevo">@context.ValorNuevo</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Guardar contribuyente</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="SyncTseAsync">Sincronizar TSE</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SyncRegistroAsync">Sincronizar Registro Nacional</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="ExportPdfAsync" Size="Size.Small">PDF</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintDocumentAsync" Size="Size.Small">Imprimir</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportHtmlAsync" Size="Size.Small">HTML</MudButton>
    </div>
</MudPaper>

@code {
    [Parameter] public ContribuyenteDto Model { get; set; } = new();
    [Parameter] public EventCallback<ContribuyenteDto> ModelChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private List<string> tiposPersona = new();
    private List<string> tiposIdentificacion = new();
    private List<string> estadosContribuyente = new();
    private List<string> distritos = new();
    private List<string> actividades = new();
    private List<string> provincias = new();
    private List<string> cantones = new();
    private List<string> estadosCiviles = new();
    private List<string> nacionalidades = new();
    private List<string> validationErrors = new();
    private List<AuditoriaCambioDto> Historial = new();

    protected override async Task OnInitializedAsync()
    {
        tiposPersona = await MaestroDatosService.GetTiposPersonaAsync();
        tiposIdentificacion = await MaestroDatosService.GetTiposIdentificacionAsync();
        estadosContribuyente = await MaestroDatosService.GetEstadosContribuyenteAsync();
        distritos = await MaestroDatosService.GetDistritosAsync();
        actividades = await MaestroDatosService.GetActividadesEconomicasAsync();
        provincias = await MaestroDatosService.GetProvinciasAsync();
        cantones = await MaestroDatosService.GetCantonesAsync();
        estadosCiviles = await MaestroDatosService.GetEstadosCivilesAsync();
        nacionalidades = await MaestroDatosService.GetNacionalidadesAsync();
        Historial = await AuditoriaService.GetByContribuyenteAsync(Model.Id);
    }

    protected override async Task OnParametersSetAsync()
    {
        Historial = await AuditoriaService.GetByContribuyenteAsync(Model.Id);
    }

    private async Task SaveAsync()
    {
        validationErrors = ValidateModel();
        if (validationErrors.Any())
        {
            Snackbar.Add("Existen validaciones pendientes en el formulario.", Severity.Warning);
            return;
        }

        await ContribuyentesService.SaveAsync(Model);
        await AuditoriaService.RegistrarCambioAsync(Model.Id == 0 ? 1 : Model.Id, new AuditoriaCambioDto
        {
            Usuario = "analista.ruc",
            FechaHora = DateTime.Now,
            CampoModificado = "Registro general",
            ValorAnterior = "N/A",
            ValorNuevo = Model.NombreCompleto,
            Origen = "Formulario RUC"
        });
        Historial = await AuditoriaService.GetByContribuyenteAsync(Model.Id == 0 ? 1 : Model.Id);
        await ModelChanged.InvokeAsync(Model);
        await OnSaved.InvokeAsync();
        Snackbar.Add("Contribuyente guardado correctamente.", Severity.Success);
    }

    private async Task SyncTseAsync()
    {
        await ContribuyentesService.SimularActualizacionTseAsync(Model);
        await AuditoriaService.RegistrarCambioAsync(Model.Id == 0 ? 1 : Model.Id, new AuditoriaCambioDto
        {
            Usuario = "integracion.tse",
            FechaHora = DateTime.Now,
            CampoModificado = "Datos físicos / indicador difunto",
            ValorAnterior = "Sincronización previa",
            ValorNuevo = Model.IndicadorDifunto ? "Marcado como difunto" : "Datos actualizados",
            Origen = "TSE"
        });
        Historial = await AuditoriaService.GetByContribuyenteAsync(Model.Id == 0 ? 1 : Model.Id);
        await ModelChanged.InvokeAsync(Model);
        Snackbar.Add("Sincronización TSE completada correctamente.", Severity.Info);
    }

    private async Task SyncRegistroAsync()
    {
        await ContribuyentesService.SimularActualizacionRegistroNacionalAsync(Model);
        await AuditoriaService.RegistrarCambioAsync(Model.Id == 0 ? 1 : Model.Id, new AuditoriaCambioDto
        {
            Usuario = "integracion.registronacional",
            FechaHora = DateTime.Now,
            CampoModificado = "Representación legal",
            ValorAnterior = "Sin representante verificado",
            ValorNuevo = Model.RepresentanteLegal.NombreCompleto,
            Origen = "Registro Nacional"
        });
        Historial = await AuditoriaService.GetByContribuyenteAsync(Model.Id == 0 ? 1 : Model.Id);
        await ModelChanged.InvokeAsync(Model);
        Snackbar.Add("Sincronización con Registro Nacional completada.", Severity.Info);
    }

    private List<string> ValidateModel()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(Model.NumeroIdentificacion))
            errors.Add("La identificación es obligatoria.");
        if (Model.TipoPersona == "Juridica" && string.IsNullOrWhiteSpace(Model.RazonSocial))
            errors.Add("La razón social es obligatoria.");
        if (Model.TipoPersona == "Fisica" && string.IsNullOrWhiteSpace(Model.Nombre))
            errors.Add("El nombre es obligatorio.");
        if (!ValidationHelper.ValidarCorreo(Model.Correo, out var correoError) && !string.IsNullOrWhiteSpace(correoError))
            errors.Add(correoError);
        if (!ValidationHelper.ValidarTelefono(Model.Telefono, out var telefonoError) && !string.IsNullOrWhiteSpace(telefonoError))
            errors.Add(telefonoError);
        if (string.IsNullOrWhiteSpace(Model.DireccionFiscal.DireccionExacta))
            errors.Add("La dirección fiscal es obligatoria.");
        if (Model.TipoPersona == "Juridica" && string.IsNullOrWhiteSpace(Model.RepresentanteLegal.NombreCompleto))
            errors.Add("El representante legal es obligatorio para persona jurídica.");
        if (!estadosContribuyente.Contains(Model.EstadoContribuyente))
            errors.Add("El estado del contribuyente no es permitido.");
        return errors;
    }

    private string? ValidarTelefono(string value)
    {
        ValidationHelper.ValidarTelefono(value, out var error);
        return error;
    }

    private string? ValidarCorreo(string value)
    {
        ValidationHelper.ValidarCorreo(value, out var error);
        return error;
    }

    private void FormatearTelefono()
    {
        if (!string.IsNullOrWhiteSpace(Model.Telefono))
            Model.Telefono = ValidationHelper.FormatearTelefono(Model.Telefono);
    }

    private void FormatearTelefonoRepresentante()
    {
        if (!string.IsNullOrWhiteSpace(Model.RepresentanteLegal.Telefono))
            Model.RepresentanteLegal.Telefono = ValidationHelper.FormatearTelefono(Model.RepresentanteLegal.Telefono);
    }

    private Task<IEnumerable<string>> SearchNacionalidadAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(nacionalidades.AsEnumerable());

        var normalized = value.Trim().ToLowerInvariant();
        var results = nacionalidades
            .Where(n => n.ToLowerInvariant().Contains(normalized))
            .AsEnumerable();

        return Task.FromResult(results);
    }

    private async Task ExportHtmlAsync()
    {
        var content = BuildContribuyenteDocument();
        var fileName = $"Contribuyente_{Helpers.DocumentExportHelper.SanitizeFileName(Model.NumeroIdentificacion)}.html";
        await DocumentExportHelper.ExportAsHtmlAsync(content, fileName);
    }

    private async Task PrintDocumentAsync()
    {
        var content = BuildContribuyenteDocument();
        await DocumentExportHelper.PrintHtmlAsync(content);
    }

    private async Task ExportPdfAsync()
    {
        var content = BuildContribuyenteDocument();
        var fileName = $"Contribuyente_{Helpers.DocumentExportHelper.SanitizeFileName(Model.NumeroIdentificacion)}.pdf";
        await DocumentExportHelper.ExportAsPdfAsync(content, fileName);
    }

    private string BuildContribuyenteDocument()
    {
        var sb = new System.Text.StringBuilder();

        sb.Append("<div class='section'>");
        sb.Append("<div class='section-title'>Información General</div>");
        sb.AppendFormat("<div class='field'><span class='field-label'>Tipo de persona:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.TipoPersona));
        sb.AppendFormat("<div class='field'><span class='field-label'>Tipo de identificación:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.TipoIdentificacion));
        sb.AppendFormat("<div class='field'><span class='field-label'>Número de identificación:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.NumeroIdentificacion));

        if (Model.TipoPersona == "Fisica")
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Nombre:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.Nombre));
            if (!string.IsNullOrWhiteSpace(Model.Apellidos))
            {
                sb.AppendFormat("<div class='field'><span class='field-label'>Apellidos:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.Apellidos));
            }
            if (!string.IsNullOrWhiteSpace(Model.EstadoCivil))
            {
                sb.AppendFormat("<div class='field'><span class='field-label'>Estado civil:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.EstadoCivil));
            }
        }
        else
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Razón social:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.RazonSocial));
        }

        if (!string.IsNullOrWhiteSpace(Model.Nacionalidad))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Nacionalidad:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.Nacionalidad));
        }
        if (!string.IsNullOrWhiteSpace(Model.Telefono))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Teléfono:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.Telefono));
        }
        if (!string.IsNullOrWhiteSpace(Model.Correo))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Correo:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.Correo));
        }
        sb.AppendFormat("<div class='field'><span class='field-label'>Estado:</span><span class='field-value'><span class='badge badge-info'>{0}</span></span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.EstadoContribuyente));
        sb.Append("</div>");

        sb.Append("<div class='section'>");
        sb.Append("<div class='section-title'>Dirección Fiscal</div>");
        if (!string.IsNullOrWhiteSpace(Model.DireccionFiscal.Provincia))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Provincia:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.DireccionFiscal.Provincia));
        }
        if (!string.IsNullOrWhiteSpace(Model.DireccionFiscal.Canton))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Cantón:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.DireccionFiscal.Canton));
        }
        if (!string.IsNullOrWhiteSpace(Model.DireccionFiscal.Distrito))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Distrito:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.DireccionFiscal.Distrito));
        }
        if (!string.IsNullOrWhiteSpace(Model.DireccionFiscal.DireccionExacta))
        {
            sb.AppendFormat("<div class='field'><span class='field-label'>Dirección exacta:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.DireccionFiscal.DireccionExacta));
        }
        sb.Append("</div>");

        if (Model.TipoPersona == "Juridica" && !string.IsNullOrWhiteSpace(Model.RepresentanteLegal.NombreCompleto))
        {
            sb.Append("<div class='section'>");
            sb.Append("<div class='section-title'>Representante Legal</div>");
            sb.AppendFormat("<div class='field'><span class='field-label'>Nombre:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.RepresentanteLegal.NombreCompleto));
            if (!string.IsNullOrWhiteSpace(Model.RepresentanteLegal.Identificacion))
            {
                sb.AppendFormat("<div class='field'><span class='field-label'>Identificación:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.RepresentanteLegal.Identificacion));
            }
            if (!string.IsNullOrWhiteSpace(Model.RepresentanteLegal.Telefono))
            {
                sb.AppendFormat("<div class='field'><span class='field-label'>Teléfono:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.RepresentanteLegal.Telefono));
            }
            if (!string.IsNullOrWhiteSpace(Model.RepresentanteLegal.Correo))
            {
                sb.AppendFormat("<div class='field'><span class='field-label'>Correo:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.RepresentanteLegal.Correo));
            }
            sb.Append("</div>");
        }

        if (!string.IsNullOrWhiteSpace(Model.ActividadEconomica))
        {
            sb.Append("<div class='section'>");
            sb.Append("<div class='section-title'>Actividad Económica</div>");
            sb.AppendFormat("<div class='field'><span class='field-label'>Actividad:</span><span class='field-value'>{0}</span></div>", Helpers.DocumentExportHelper.HtmlEncode(Model.ActividadEconomica));
            sb.Append("</div>");
        }

        if (Model.TributosVinculados.Any())
        {
            sb.Append("<div class='section'>");
            sb.Append("<div class='section-title'>Tributos Vinculados</div>");
            sb.Append("<table>");
            sb.Append("<thead><tr><th>Código</th><th>Nombre</th><th>Estado</th></tr></thead>");
            sb.Append("<tbody>");
            foreach (var tributo in Model.TributosVinculados)
            {
                sb.Append("<tr>");
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(tributo.Codigo));
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(tributo.Nombre));
                sb.AppendFormat("<td><span class='badge badge-info'>{0}</span></td>", Helpers.DocumentExportHelper.HtmlEncode(tributo.Estado));
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            sb.Append("</div>");
        }

        if (Model.BienesInmueblesVinculados.Any())
        {
            sb.Append("<div class='section'>");
            sb.Append("<div class='section-title'>Bienes Inmuebles Vinculados</div>");
            sb.Append("<table>");
            sb.Append("<thead><tr><th>Finca</th><th>Distrito</th><th>Uso</th><th>Estado</th></tr></thead>");
            sb.Append("<tbody>");
            foreach (var bien in Model.BienesInmueblesVinculados)
            {
                sb.Append("<tr>");
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(bien.FincaNumero));
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(bien.Distrito));
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(bien.Uso));
                sb.AppendFormat("<td><span class='badge badge-info'>{0}</span></td>", Helpers.DocumentExportHelper.HtmlEncode(bien.Estado));
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            sb.Append("</div>");
        }

        if (Historial.Any())
        {
            sb.Append("<div class='section'>");
            sb.Append("<div class='section-title'>Historial de Cambios</div>");
            sb.Append("<table>");
            sb.Append("<thead><tr><th>Usuario</th><th>Fecha</th><th>Campo</th><th>Valor anterior</th><th>Valor nuevo</th></tr></thead>");
            sb.Append("<tbody>");
            foreach (var hist in Historial.OrderByDescending(h => h.FechaHora))
            {
                sb.Append("<tr>");
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(hist.Usuario));
                sb.AppendFormat("<td>{0}</td>", hist.FechaHora.ToString("dd/MM/yyyy HH:mm"));
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(hist.CampoModificado));
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(hist.ValorAnterior));
                sb.AppendFormat("<td>{0}</td>", Helpers.DocumentExportHelper.HtmlEncode(hist.ValorNuevo));
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            sb.Append("</div>");
        }

        return Helpers.DocumentExportHelper.BuildMunicipalDocument("Expediente de Contribuyente", Model.NumeroIdentificacion, sb.ToString());
    }
}
