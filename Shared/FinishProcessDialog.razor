@using System.Collections.Generic
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body1">@Message</MudText>
            @if (Warnings.Count > 0)
            {
                @foreach (var item in Warnings)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@item</MudAlert>
                }
            }
            else
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No hay advertencias pendientes para este cierre.</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Back">Volver</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Confirm">Finalizar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "Finalizar proceso";
    [Parameter] public string Message { get; set; } = "Revise el resumen antes de completar el proceso.";
    [Parameter] public List<string> Warnings { get; set; } = new();

    private void Back() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
