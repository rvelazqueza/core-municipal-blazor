@using System.Collections.Generic
@using System.Linq
@using BlazorApp.Models
@using MudBlazor

<MudCard Outlined="true">
    <MudCardContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1">@Title</MudText>

            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                <MudChip T="string" Text="@($"Total: {totalCount}")" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" />
                <MudChip T="string" Text="@($"Correctas: {successCount}")" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" />
                <MudChip T="string" Text="@($"Advertencias: {warningCount}")" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" />
                <MudChip T="string" Text="@($"Errores: {errorCount}")" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" />
                <MudChip T="string" Text="@($"Pendientes: {pendingCount}")" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" />
            </MudStack>

            @if (messages.Any())
            {
                <MudStack Spacing="1">
                    @foreach (var item in messages)
                    {
                        <MudAlert Severity="@ResolveSeverity(item.Severity)" Variant="Variant.Outlined" Dense="true">@item.Text</MudAlert>
                    }
                </MudStack>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No hay validaciones pendientes.</MudAlert>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = "Resumen de validaciones";
    [Parameter] public List<StepValidationResultDto> ValidationResults { get; set; } = new();

    private int totalCount => ValidationResults.Count;
    private int errorCount => ValidationResults.Count(item => ResolveSeverity(item) == Severity.Error);
    private int warningCount => ValidationResults.Count(item => ResolveSeverity(item) == Severity.Warning);
    private int successCount => ValidationResults.Count(item => ResolveSeverity(item) == Severity.Success);
    private int pendingCount => ValidationResults.Count(item => ResolveSeverity(item) == Severity.Info);

    private List<(string Text, string Severity)> messages => ValidationResults
        .SelectMany(item => (item.Messages.Any() ? item.Messages : new List<string> { item.Message })
            .Where(message => !string.IsNullOrWhiteSpace(message))
            .Select(message => (message, item.Severity)))
        .Distinct()
        .ToList();

    private static Severity ResolveSeverity(StepValidationResultDto result)
        => ResolveSeverity(result.Severity, result.IsValid, result.HasWarnings);

    private static Severity ResolveSeverity(string severity, bool isValid = true, bool hasWarnings = false)
    {
        if (!string.IsNullOrWhiteSpace(severity))
        {
            if (severity.Equals("Error", System.StringComparison.OrdinalIgnoreCase))
                return Severity.Error;
            if (severity.Equals("Warning", System.StringComparison.OrdinalIgnoreCase))
                return Severity.Warning;
            if (severity.Equals("Success", System.StringComparison.OrdinalIgnoreCase))
                return Severity.Success;
        }

        if (!isValid)
            return Severity.Error;
        if (hasWarnings)
            return Severity.Warning;
        return Severity.Info;
    }
}
