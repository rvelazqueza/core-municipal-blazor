@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using BlazorApp.Models.PermisosConstruccion
@using MudBlazor

<MudStack Spacing="3">
    <MudPaper Outlined="true" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3"><MudDatePicker Label="Fecha desde" @bind-Date="fromDate" PickerVariant="PickerVariant.Dialog" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField T="string" @bind-Value="userFilter" Label="Usuario" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField T="string" @bind-Value="statusFilter" Label="Estado" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField T="string" @bind-Value="originFilter" Label="Origen" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-3">
            <MudChip T="string" Text="@($"Eventos {FilteredItems.Count()}")" Color="Color.Info" Variant="Variant.Outlined" />
            <MudChip T="string" Text="@($"Plataforma {CountByOrigin("Plataforma de Servicios")}")" Color="Color.Primary" Variant="Variant.Outlined" />
            <MudChip T="string" Text="@($"GIS {CountByOrigin("GIS")}")" Color="Color.Success" Variant="Variant.Outlined" />
        </MudStack>
    </MudPaper>

    <MudTable T="PcHistoryEventDto" Items="@FilteredItems" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Fecha</MudTh><MudTh>Usuario</MudTh><MudTh>Acción</MudTh><MudTh>Estado anterior</MudTh><MudTh>Estado nuevo</MudTh><MudTh>Departamento</MudTh><MudTh>Comentario</MudTh><MudTh>Origen</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Date.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd>@context.User</MudTd>
            <MudTd>@context.Action</MudTd>
            <MudTd>@context.PreviousStatus</MudTd>
            <MudTd>@context.NewStatus</MudTd>
            <MudTd>@context.Department</MudTd>
            <MudTd>@context.Comment</MudTd>
            <MudTd>@context.Origin</MudTd>
        </RowTemplate>
    </MudTable>
</MudStack>

@code {
    [Parameter] public PcPermitDto Permit { get; set; } = new();

    private DateTime? fromDate;
    private string userFilter = string.Empty;
    private string statusFilter = string.Empty;
    private string originFilter = string.Empty;

    private IEnumerable<PcHistoryEventDto> FilteredItems => Permit.HistoryEvents.Where(Matches).OrderByDescending(x => x.Date);

    private bool Matches(PcHistoryEventDto item) =>
        (!fromDate.HasValue || item.Date.Date >= fromDate.Value.Date) &&
        Contains(item.User, userFilter) &&
        (Contains(item.NewStatus, statusFilter) || Contains(item.PreviousStatus, statusFilter)) &&
        Contains(item.Origin, originFilter);

    private int CountByOrigin(string origin) => Permit.HistoryEvents.Count(x => x.Origin.Contains(origin, StringComparison.OrdinalIgnoreCase));
    private static bool Contains(string source, string filter) => string.IsNullOrWhiteSpace(filter) || source.Contains(filter, StringComparison.OrdinalIgnoreCase);
}