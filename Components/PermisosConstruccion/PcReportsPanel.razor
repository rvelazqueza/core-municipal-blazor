@using System
@using System.Linq
@using Microsoft.AspNetCore.Components
@using BlazorApp.Models.PermisosConstruccion
@using MudBlazor
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <div>
                <MudText Typo="Typo.h6">Reportería mock</MudText>
                <MudText Typo="Typo.body2">Exportaciones simuladas sin PDF, Excel ni Word reales.</MudText>
            </div>
            <MudChip T="string" Text="@($"Reportes {Permit.Reports.Count}")" Color="Color.Info" Variant="Variant.Filled" />
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(SelectedReport))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                @SelectedReport
            </MudAlert>
        }
    </MudPaper>

    <MudGrid Spacing="2">
        @foreach (var report in Permit.Reports)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">@report.Name</MudText>
                            <MudChip T="string" Text="@report.Category" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@report.Description</MudText>
                            <MudText Typo="Typo.caption">Filtros principales: @report.MainFilters</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="pa-2">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => ViewMock(report))">Ver mock</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ExportMockAsync">Exportar Excel mock</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ExportMockAsync">Exportar PDF mock</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ExportMockAsync">Exportar Word mock</MudButton>
                        </MudStack>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    [Parameter] public PcPermitDto Permit { get; set; } = new();
    private string SelectedReport { get; set; } = string.Empty;

    private void ViewMock(PcReportDto report)
    {
        SelectedReport = $"Vista mock activa para: {report.Name}";
        Snackbar.Add(SelectedReport, Severity.Info);
    }

    private Task ExportMockAsync()
    {
        Snackbar.Add("Exportación disponible en implementación backend.", Severity.Info);
        return Task.CompletedTask;
    }
}