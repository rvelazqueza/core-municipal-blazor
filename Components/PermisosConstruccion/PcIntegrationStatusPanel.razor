@using System
@using System.Linq
@using Microsoft.AspNetCore.Components
@using BlazorApp.Models.PermisosConstruccion
@using MudBlazor
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudChip T="string" Text="@($"Simuladas {CountByStatus("Simulado")}")" Color="Color.Info" Variant="Variant.Outlined" />
            <MudChip T="string" Text="@($"Referenciales {CountByStatus("Referencial")}")" Color="Color.Warning" Variant="Variant.Outlined" />
            <MudChip T="string" Text="@($"Preparadas {CountByStatus("Preparado")}")" Color="Color.Success" Variant="Variant.Outlined" />
            <MudChip T="string" Text="@($"No MVP {CountByStatus("No incluido en MVP")}")" Color="Color.Dark" Variant="Variant.Outlined" />
        </MudStack>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
            Todas las integraciones son visuales; el botón visualiza un evento mock y rota el estado mostrado.
        </MudAlert>
    </MudPaper>

    <MudGrid Spacing="2">
        @foreach (var item in Permit.Integrations.OrderBy(x => x.Category).ThenBy(x => x.Name))
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Outlined="true" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">@item.Name</MudText>
                            <MudChip T="string" Text="@item.Status" Color="@ResolveColor(item.Status)" Variant="Variant.Outlined" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@item.Description</MudText>
                            <MudText Typo="Typo.caption">Último evento mock: @item.LastEvent</MudText>
                            <MudText Typo="Typo.caption">@item.Category</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => CycleStatus(item))">Acción visual</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    [Parameter] public PcPermitDto Permit { get; set; } = new();

    private int CountByStatus(string status) => Permit.Integrations.Count(x => string.Equals(x.Status, status, StringComparison.OrdinalIgnoreCase));

    private void CycleStatus(PcIntegrationStatusDto item)
    {
        item.Status = item.Status switch
        {
            "Simulado" => "Preparado",
            "Preparado" => "Referencial",
            "Referencial" => "No incluido en MVP",
            _ => "Simulado"
        };

        item.LastEvent = $"Evento mock: {DateTime.Now:dd/MM HH:mm}";
        Snackbar.Add($"{item.Name} cambiado a estado {item.Status}.", Severity.Info);
    }

    private static Color ResolveColor(string status) => status switch
    {
        "Simulado" => Color.Info,
        "Referencial" => Color.Warning,
        "Preparado" => Color.Success,
        "No incluido en MVP" => Color.Dark,
        _ => Color.Default
    };
}