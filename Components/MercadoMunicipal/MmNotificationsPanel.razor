@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using BlazorApp.Models
@using MudBlazor
@inject ISnackbar Snackbar

@if (Local is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">No existe información del local para notificaciones.</MudAlert>
}
else
{
    <div class="d-flex flex-column gap-3">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Las notificaciones y la firma digital son simuladas; no se envían mensajes ni documentos reales.
        </MudAlert>

        <MudPaper Outlined="true" Class="pa-4">
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GenerateAsync">Generar notificación mock</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="SignAsync">Firmar digitalmente mock</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="SendAsync">Enviar mock</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintAsync">Imprimir mock</MudButton>
            </div>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 overflow-x-auto">
            <MudTable T="MmNotificationDto" Items="@Items.OrderByDescending(x => x.CreatedAt)" Hover="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>Número</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Medio</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Firma digital referencial</MudTh>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Destino</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Número">@context.NotificationNumber</MudTd>
                    <MudTd DataLabel="Tipo">@context.Type</MudTd>
                    <MudTd DataLabel="Medio">@context.Medium</MudTd>
                    <MudTd DataLabel="Estado">@context.Status</MudTd>
                    <MudTd DataLabel="Firma digital referencial">@context.DigitalSignatureReference</MudTd>
                    <MudTd DataLabel="Fecha">@context.CreatedAt.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Destino">@context.TargetName</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </div>
}

@code {
    [Parameter] public MmLocalDto? Local { get; set; }
    [Parameter] public MmTenantDto? Tenant { get; set; }
    [Parameter] public List<MmNotificationDto> Items { get; set; } = new();
    [Parameter] public List<MmHistoryEventDto> HistoryItems { get; set; } = new();
    [Parameter] public List<MmAuditEventDto> AuditItems { get; set; } = new();

    private Task GenerateAsync()
    {
        if (Local is null)
            return Task.CompletedTask;

        var item = new MmNotificationDto
        {
            Id = $"NOT-MOCK-{Items.Count + 1:000}",
            LocalId = Local.Id,
            NotificationNumber = $"NOT-MOCK-{DateTime.Now:HHmmss}",
            Type = "Informativa",
            Medium = "Plataforma digital",
            Status = "Generada",
            DigitalSignatureReference = "Pendiente firma mock",
            CreatedAt = DateTime.Today,
            TargetName = Tenant?.Name ?? Local.BusinessName
        };

        Items.Insert(0, item);
        RegisterMockEvent("Generar notificación", string.Empty, item.NotificationNumber, "Notificaciones", "Media");
        Snackbar.Add("Notificación mock generada.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task SignAsync()
    {
        var item = Items.OrderByDescending(x => x.CreatedAt).FirstOrDefault();
        if (item is null)
            return Task.CompletedTask;

        item.DigitalSignatureReference = "Firma digital mock aplicada";
        RegisterMockEvent("Firmar notificación", "Pendiente", item.DigitalSignatureReference, "Notificaciones", "Baja");
        Snackbar.Add("Firma digital mock aplicada.", Severity.Success);
        return Task.CompletedTask;
    }

    private Task SendAsync()
    {
        var item = Items.OrderByDescending(x => x.CreatedAt).FirstOrDefault();
        if (item is null)
            return Task.CompletedTask;

        item.Status = "Enviada mock";
        RegisterMockEvent("Enviar notificación", "Generada", item.Status, "Notificaciones", "Media");
        Snackbar.Add("Notificación mock enviada.", Severity.Success);
        return Task.CompletedTask;
    }

    private Task PrintAsync()
    {
        var item = Items.OrderByDescending(x => x.CreatedAt).FirstOrDefault();
        if (item is null)
            return Task.CompletedTask;

        item.Status = "Impresa mock";
        RegisterMockEvent("Imprimir notificación", "Generada", item.Status, "Notificaciones", "Baja");
        Snackbar.Add("Notificación mock enviada a impresión referencial.", Severity.Info);
        return Task.CompletedTask;
    }

    private void RegisterMockEvent(string action, string previousValue, string currentValue, string process, string severity)
    {
        if (Local is null)
            return;

        HistoryItems.Insert(0, new MmHistoryEventDto
        {
            Id = $"HIS-MOCK-{HistoryItems.Count + 1:000}",
            LocalId = Local.Id,
            Date = DateTime.Now,
            User = "Usuario Mercado",
            Action = action,
            PreviousStatus = "Registrado",
            NewStatus = "Actualizado",
            PreviousValue = previousValue,
            NewValue = currentValue,
            SourceDocument = "Panel notificaciones",
            SourceProcess = process,
            Comment = "Evento mock generado desde notificaciones."
        });

        AuditItems.Insert(0, new MmAuditEventDto
        {
            Id = $"AUD-MOCK-{AuditItems.Count + 1:000}",
            LocalId = Local.Id,
            Date = DateTime.Now,
            User = "Usuario Mercado",
            Action = action,
            PreviousValue = previousValue,
            CurrentValue = currentValue,
            SourceDocument = "Panel notificaciones",
            Process = process,
            Severity = severity,
            OutputReference = "Bitácora visual mock"
        });
    }
}
