@using BlazorApp.Models.Auditoria

<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <div class="d-flex flex-wrap justify-space-between align-center gap-2">
            <div>
                <MudText Typo="Typo.h6">Auditoría de integraciones institucionales</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Eventos operativos entre módulos institucionales.</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@($"{Events.Count()} eventos")</MudChip>
        </div>

        <MudTable T="AuditIntegrationEventDto" Items="@Events" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Integración</MudTh>
                <MudTh>Módulo origen</MudTh>
                <MudTh>Módulo destino</MudTh>
                <MudTh>Evento</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Mensaje</MudTh>
                <MudTh>CorrelationId</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Integración">@context.Action</MudTd>
                <MudTd DataLabel="Módulo origen">@context.ModuleOrigin</MudTd>
                <MudTd DataLabel="Módulo destino">@context.ModuleDestination</MudTd>
                <MudTd DataLabel="Evento">@context.EventType</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Color="@GetStateColor(context.IntegrationState)" Variant="Variant.Outlined" Size="Size.Small">@context.IntegrationState</MudChip>
                </MudTd>
                <MudTd DataLabel="Fecha">@context.EventDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Mensaje">@context.ResultMessage</MudTd>
                <MudTd DataLabel="CorrelationId">@context.CorrelationId</MudTd>
            </RowTemplate>
        </MudTable>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IEnumerable<AuditIntegrationEventDto> Events { get; set; } = Array.Empty<AuditIntegrationEventDto>();

    private static Color GetStateColor(string state) => state switch
    {
        "Fallido" => Color.Error,
        "Preparado" => Color.Success,
        "Referencial" => Color.Info,
        "Procesado" => Color.Primary,
        _ => Color.Warning
    };
}