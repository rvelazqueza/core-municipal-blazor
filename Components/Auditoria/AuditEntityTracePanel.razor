@using BlazorApp.Models.Auditoria

<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <div class="d-flex flex-wrap justify-space-between align-center gap-2">
            <div>
                <MudText Typo="Typo.h6">Trazabilidad por entidad</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@($"{EntityName} · {EntityId}")</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@($"{Events.Count()} eventos")</MudChip>
        </div>

        @if (Events is null || !Events.Any())
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No se encontraron eventos relacionados para la entidad seleccionada.</MudAlert>
        }
        else
        {
            var latest = Events.OrderByDescending(x => x.EventDate).First();
            var orderedEvents = Events.OrderByDescending(x => x.EventDate).ToList();
            <MudGrid Spacing="2">
                <MudItem xs="12" md="3">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption">Última modificación</MudText>
                        <MudText>@latest.EventDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption">Usuario responsable</MudText>
                        <MudText>@latest.UserName</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption">Estado actual</MudText>
                        <MudText>@latest.Status</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption">Módulo propietario</MudText>
                        <MudText>@latest.Module</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudTable T="AuditEventDto" Items="@orderedEvents" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Usuario</MudTh>
                    <MudTh>Módulo</MudTh>
                    <MudTh>Acción</MudTh>
                    <MudTh>Cambios principales</MudTh>
                    <MudTh>Estado</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fecha">@context.EventDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Usuario">@context.UserName</MudTd>
                    <MudTd DataLabel="Módulo">@context.Module</MudTd>
                    <MudTd DataLabel="Acción">@context.Action</MudTd>
                    <MudTd DataLabel="Cambios principales">@($"{context.PreviousValue} → {context.NewValue}")</MudTd>
                    <MudTd DataLabel="Estado">@context.Status</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string EntityName { get; set; } = string.Empty;
    [Parameter] public string EntityId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IEnumerable<AuditEventDto> Events { get; set; } = Array.Empty<AuditEventDto>();
}